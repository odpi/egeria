ass":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"GovernanceControl","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"CLASSIFICATION_DEF","typeDefGUID":"aa44f302-2e43-4669-a1e7-edaae414fc6e","typeDefName":"Anchors","typeDefVersion":1},"updateTime":1775025949989,"updatedBy":"Egeria Project","version":1793024468194}],"createTime":1775025949989,"createdBy":"Egeria Project","guid":"3b612283-9fb8-410d-bdd5-b45dc320c492","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"e0eabb0c-d3ce-411e-8218-d1de75c354a6","metadataCollectionName":"SecurityContentPack","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"authors":{"class":"ArrayPropertyValue","arrayCount":1,"arrayValues":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"0":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"National Institute of Standards and Technology (NIST)","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"headerVersion":1,"instancePropertyCategory":"ARRAY","typeGUID":"0428b5d3-f824-459c-b7f5-f8151de59707","typeName":"array<string>"},"description":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Provide [Selection (one or more): physical; logical] disconnect of collaborative computing devices in a manner that supports ease of use.","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"displayName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"SC-15(1) Physical or Logical Disconnect","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"domainIdentifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_INT","primitiveValue":3,"typeGUID":"7fc49104-fd3a-46c8-b6bf-f16b6074cd35","typeName":"int"},"identifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"SC-15(1)","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"qualifiedName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"NIST SP 800-53 Rev 5::SC-15(1)","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"usage":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Failing to disconnect from collaborative computing devices can result in subsequent compromises of organizational information. Providing easy methods to disconnect from such devices after a collaborative computing session ensures that participants carry out the disconnect activity without having to go through complex and tedious procedures. Disconnect from collaborative computing devices can be manual or automatic.","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"ENTITY_DEF","typeDefGUID":"c794985e-a10b-4b6c-9dc2-6b2e0a2901d3","typeDefName":"GovernanceControl","typeDefVersion":1},"updateTime":1775025949989,"updatedBy":"Egeria Project","version":1793024468194},{"class":"EntityDetail","classifications":[{"class":"Classification","classificationOrigin":"ASSIGNED","createTime":1775025949989,"c