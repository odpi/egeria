Y","typeGUID":"0428b5d3-f824-459c-b7f5-f8151de59707","typeName":"array<string>"},"description":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"If system component failures are detected:\n  (a) Ensure that the standby components are successfully and transparently installed within [Assignment: organization-defined time period] ; and\n  (b) [Selection (one or more): activate [Assignment: organization-defined alarm] ; automatically shut down the system; [Assignment: organization-defined action] ].","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"displayName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"SI-13(4) Standby Component Installation and Notification","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"domainIdentifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_INT","primitiveValue":3,"typeGUID":"7fc49104-fd3a-46c8-b6bf-f16b6074cd35","typeName":"int"},"identifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"SI-13(4)","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"qualifiedName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"NIST SP 800-53 Rev 5::SI-13(4)","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"usage":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Automatic or manual transfer of components from standby to active mode can occur upon the detection of component failures.","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"ENTITY_DEF","typeDefGUID":"c794985e-a10b-4b6c-9dc2-6b2e0a2901d3","typeDefName":"GovernanceControl","typeDefVersion":1},"updateTime":1775025949989,"updatedBy":"Egeria Project","version":1793024468194},{"class":"EntityDetail","classifications":[{"class":"Classification","classificationOrigin":"ASSIGNED","createTime":1775025949989,"createdBy":"Egeria Project","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"e0eabb0c-d3ce-411e-8218-d1de75c354a6","metadataCollectionName":"SecurityContentPack","name":"Anchors","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"anchorDomainName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"AuthoredReferenceable","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"anchorTypeName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"GovernanceControl","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"CLASSIFICATION_DEF","typeDefGUID":"aa44f302-2e43-4669-a1e7-edaae414fc6e","typeDefName":"Anchors","typeDefVersion":1},"updateTime":1775025949989,"updatedBy":"Egeria Project","version":1793024468194}],"createTime":1775025949989,"createdBy":"Egeria Project","guid":"daa689a5-24ab-4342-803d-6c4baa971587","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"e0eabb0c-d3ce-411e-8218-d1de75c354a6","metadataCollectionName":"SecurityContentPack","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"authors":{"class":"ArrayPropertyValue","arrayCount":1,"arrayValues":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"0":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"National Institute of Standards and Technology (NIST)","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"headerVersion":1,"instancePropertyCategory":"ARRAY","typeGUID":"0428b5d3-f824-459c-b7f5-f8151de59707","typeName":"array<string>"},"description":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Provide [Selection: real-time; near real-time] [Assignment: organization-defined failover capability] for the system.","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"displayName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"SI-13(5) Failover Capability","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"domainIdentifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_INT","primitiveValue":3,"typeGUID":"7fc49104-fd3a-46c8-b6bf-f16b6074cd35","typeName":"int"},"identifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"SI-13(5)","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"qualifiedName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"NIST SP 800-53 Rev 5::SI-13(5)","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"usage":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Failover refers to the automatic switchover to an alternate system upon the failure of the primary system. Failover capability includes incorporating mirrored system operations at alternate processing sites or periodic data mirroring at regular intervals defined by the recovery time periods of organizations.","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"ENTITY_DEF","typeDefGUID":"c794985e-a10b-4b6c-9dc2-6b2e0a2901d3","typeDefName":"GovernanceControl","typeDefVersion":1},"updateTime":1775025949989,"updatedBy":"Egeria Project","version":1793024468194},{"class":"EntityDetail","classifications":[{"class":"Classification","classificationOrigin":"ASSIGNED","createTime":1775025949989,"createdBy":"Egeria Project","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"e0eabb0c-d3ce-411e-8218-d1de75c354a6","metadataCollectionName":"SecurityContentPack","name":"Anchors","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"anchorDomainName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"AuthoredReferenceable","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"anchorTypeName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"GovernanceControl","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"CLASSIFICATION_DEF","typeDefGUID":"aa44f302-2e43-4669-a1e7-edaae414fc6e","typeDefName":"Anchors","typeDefVersion":1},"updateTime":1775025949989,"updatedBy":"Egeria Project","version":1793024468194}],"createTime":1775025949989,"createdBy":"Egeria Project","guid":"729cb90e-7c8f-4392-9b44-ece333c6ca3c","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"e0eabb0c-d3ce-411e-8218-d1de75c354a6","metadataCollectionName":"SecurityContentPack","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"authors":{"class":"ArrayPropertyValue","arrayCount":1,"arrayValues":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"0":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"National Institute of Standards and Technology (NIST)","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"headerVersion":1,"instancePropertyCategory":"ARRAY","typeGUID":"0428b5d3-f824-459c-b7f5-f8151de59707","typeName":"array<string>"},"description":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Implement non-persistent [Assignment: organization-defined system components and services] that are initiated in a known state and terminated [Selection (one or more): upon end of session of use; [Assignment: organization-defined frequency] ].","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"displayName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"SI-14 Non-persistence","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"domainIdentifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_INT","primitiveValue":3,"typeGUID":"7fc49104-fd3a-46c8-b6bf-f16b6074cd35","typeName":"int"},"identifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"SI-14","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"qualifiedName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"NIST SP 800-53 Rev 5::SI-14","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"usage":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Implementation of non-persistent components and services mitigates risk from advanced persistent threats (APTs) by reducing the targeting capability of adversaries (i.e., window of opportunity and available attack surface) to initiate and complete attacks. By implementing the concept of non-persistence for selected system components, organizations can provide a trusted, known state computing resource for a specific time period that does not give adversaries sufficient time to exploit vulnerabilities in organizational systems or operating environments. Since the APT is a high-end, sophisticated threat with regard to capability, intent, and targeting, organizations assume that over an extended period, a percentage of attacks will be successful. Non-persistent system components and services are activated as required using protected information and terminated periodically or at the end of sessions. Non-persistence increases the work factor of adversaries attempting to compromise or breach organizational systems.\n\nNon-persistence can be achieved by refreshing system components, periodically reimaging components, or using a variety of common virtualization techniques. Non-persistent services can be implemented by using virtualization techniques as part of virtual machines or as new instances of processes on physical machines (either persistent or non-persistent). The benefit of periodic refreshes of system components and services is that it does not require organizations to first determine whether compromises of components or services have occurred (something that may often be difficult to determine). The refresh of selected system components and services occurs with sufficient frequency to prevent the spread or intended impact of attacks, but not with such frequency that it makes the system unstable. Refreshes of critical components and services may be done periodically to hinder the ability of adversaries to exploit optimum windows of vulnerabilities.","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"ENTITY_DEF","typeDefGUID":"c794985e-a10b-4b6c-9dc2-6b2e0a2901d3","typeDefName":"GovernanceControl","typeDefVersion":1},"updateTime":1775025949989,"updatedBy":"Egeria Project","version":1793024468194},{"class":"EntityDetail","classifications":[{"class":"Classification","classificationOrigin":"ASSIGNED","createTime":1775025949989,"createdBy":"Egeria Project","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"e0eabb0c-d3ce-411e-8218-d1de75c354a6","metadataCollectionName":"SecurityContentPack","name":"Anchors","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"anchorDomainName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"AuthoredReferenceable","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"anchorTypeName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"GovernanceControl","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"CLASSIFICATION_DEF","typeDefGUID":"aa44f302-2e43-4669-a1e7-edaae414fc6e","typeDefName":"Anchors","typeDefVersion":1},"updateTime":1775025949989,"updatedBy":"Egeria Project","version":1793024468194}],"createTime":1775025949989,"createdBy":"Egeria Project","guid":"a3100191-d201-4193-b772-c4e0ff57fe68","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"e0eabb0c-d3ce-411e-8218-d1de75c354a6","metadataCollectionName":"SecurityContentPack","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"authors":{"class":"ArrayPropertyValue","arrayCount":1,"arrayValues":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"0":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"National Institute of Standards and Technology (NIST)","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"headerVersion":1,"instancePropertyCategory":"ARRAY","typeGUID":"0428b5d3-f824-459c-b7f5-f8151de59707","typeName":"array<string>"},"description":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Obtain software and data employed during system component and service refreshes from the following trusted sources: [Assignment: organization-defined trusted sources].","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"displayName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"SI-14(1) Refresh from Trusted Sources","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"domainIdentifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_INT","primitiveValue":3,"typeGUID":"7fc49104-fd3a-46c8-b6bf-f16b6074cd35","typeName":"int"},"identifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"SI-14(1)","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"qualifiedName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"NIST SP 800-53 Rev 5::SI-14(1)","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"usage":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Trusted sources include software and data from write-once, read-only media or from selected offline secure storage facilities.","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"ENTITY_DEF","typeDefGUID":"c794985e-a10b-4b6c-9dc2-6b2e0a2901d3","typeDefName":"GovernanceControl","typeDefVersion":1},"updateTime":1775025949989,"updatedBy":"Egeria Project","version":1793024468194},{"class":"EntityDetail","classifications":[{"class":"Classification","classificationOrigin":"ASSIGNED","createTime":1775025949989,"createdBy":"Egeria Project","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"e0eabb0c-d3ce-411e-8218-d1de75c354a6","metadataCollectionName":"SecurityContentPack","name":"Anchors","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"anchorDomainName":{"clas