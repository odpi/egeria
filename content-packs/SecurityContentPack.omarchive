n":1,"instancePropertyCategory":"ARRAY","typeGUID":"0428b5d3-f824-459c-b7f5-f8151de59707","typeName":"array<string>"},"description":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Review historic audit logs to determine if a vulnerability identified in a [Assignment: organization-defined system] has been previously exploited within an [Assignment: organization-defined time period].","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"displayName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"RA-5(8) Review Historic Audit Logs","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"domainIdentifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_INT","primitiveValue":3,"typeGUID":"7fc49104-fd3a-46c8-b6bf-f16b6074cd35","typeName":"int"},"identifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"RA-5(8)","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"qualifiedName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"NIST SP 800-53 Rev 5::RA-5(8)","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"usage":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Reviewing historic audit logs to determine if a recently detected vulnerability in a system has been previously exploited by an adversary can provide important information for forensic analyses. Such analyses can help identify, for example, the extent of a previous intrusion, the trade craft employed during the attack, organizational information exfiltrated or modified, mission or business capabilities affected, and the duration of the attack.","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"ENTITY_DEF","typeDefGUID":"c794985e-a10b-4b6c-9dc2-6b2e0a2901d3","typeDefName":"GovernanceControl","typeDefVersion":1},"updateTime":1775025949989,"updatedBy":"Egeria Project","version":1793024468194},{"class":"EntityDetail","classifications":[{"class":"Classification","classificationOrigin":"ASSIGNED","createTime":1775025949989,"createdBy":"Egeria Project","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"e0eabb0c-d3ce-411e-8218-d1de75c354a6","metadataCollectionName":"SecurityContentPack","name":"Anchors","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"anchorDomainName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"AuthoredReferenceable","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"anchorTypeName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"GovernanceControl","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"CLASSIFICATION_DEF","typeDefGUID":"aa44f302-2e43-4669-a1e7-edaae414fc6e","typeDefName":"Anchors","typeDefVersion":1},"updateTime":1775025949989,"updatedBy":"Egeria Project","version":1793024468194}],"createTime":1775025949989,"createdBy":"Egeria Project","guid":"c7fc8e21-205a-4995-ba16-61cecc218fd2","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"e0eabb0c-d3ce-411e-8218-d1de75c354a6","metadataCollectionName":"SecurityContentPack","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"authors":{"class":"ArrayPropertyValue","arrayCount":1,"arrayValues":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"0":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"National Institute of Standards and Technology (NIST)","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"headerVersion":1,"instancePropertyCategory":"ARRAY","typeGUID":"0428b5d3-f824-459c-b7f5-f8151de59707","typeName":"array<string>"},"description":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Correlate the output from vulnerability scanning tools to determine the presence of multi-vulnerability and multi-hop attack vectors.","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"displayName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"RA-5(10) Correlate Scanning Information","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"domainIdentifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_INT","primitiveValue":3,"typeGUID":"7fc49104-fd3a-46c8-b6bf-f16b6074cd35","typeName":"int"},"identifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"RA-5(10)","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"qualifiedName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"NIST SP 800-53 Rev 5::RA-5(10)","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"usage":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"An attack vector is a path or means by which an adversary can gain access to a system in order to deliver malicious code or exfiltrate information. Organizations can use attack trees to show how hostile activities by adversaries interact and combine to produce adverse impacts or negative consequences to systems and organizations. Such information, together with correlated data from vulnerability scanning tools, can provide greater clarity regarding multi-vulnerability and multi-hop attack vectors. The correlation of vulnerability scanning information is especially important when organizations are transitioning from older technologies to newer technologies (e.g., transitioning from IPv4 to IPv6 network protocols). During such transitions, some system components may inadvertently be unmanaged and create opportunities for adversary exploitation.","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"ENTITY_DEF","typeDefGUID":"c794985e-a10b-4b6c-9dc2-6b2e0a2901d3","typeDefName":"GovernanceControl","typeDefVersion":1},"updateTime":1775025949989,"updatedBy":"Egeria Project","version":1793024468194},{"class":"EntityDetail","classifications":[{"class":"Classification","classificationOrigin":"ASSIGNED","createTime":1775025949989,"createdBy":"Egeria Project","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"e0eabb0c-d3ce-411e-8218-d1de75c354a6","metadataCollectionName":"SecurityCont