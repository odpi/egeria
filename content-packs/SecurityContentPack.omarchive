"typeName":"array<string>"},"description":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Implement a policy enforcement mechanism [Selection: physically; logically] between the physical and/or network interfaces for the connecting security domains.","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"displayName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"SC-46 Cross Domain Policy Enforcement","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"domainIdentifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_INT","primitiveValue":3,"typeGUID":"7fc49104-fd3a-46c8-b6bf-f16b6074cd35","typeName":"int"},"identifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"SC-46","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"qualifiedName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"NIST SP 800-53 Rev 5::SC-46","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"usage":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"For logical policy enforcement mechanisms, organizations avoid creating a logical path between interfaces to prevent the ability to bypass the policy enforcement mechanism. For physical policy enforcement mechanisms, the robustness of physical isolation afforded by the physical implementation of policy enforcement to preclude the presence of logical covert channels penetrating the security domain may be needed. Contact [ncdsmo@nsa.gov](mailto:ncdsmo@nsa.gov) for more information.","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"ENTITY_DEF","typeDefGUID":"c794985e-a10b-4b6c-9dc2-6b2e0a2901d3","typeDefName":"GovernanceControl","typeDefVersion":1},"updateTime":1775025949989,"updatedBy":"Egeria Project","version":1793024468194},{"class":"EntityDetail","classifications":[{"class":"Classification","classificationOrigin":"ASSIGNED","createTime":1775025949989,"createdBy":"Egeria Project","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"e0eabb0c-d3ce-411e-8218-d1de75c354a6","metadataCollectionName":"SecurityContentPack","name":"Anchors","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"anchorDomainName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"AuthoredReferenceable","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"anchorTypeName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"GovernanceControl","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"CLASSIFICATION_DEF","typeDefGUID":"aa44f302-2e43-4669-a1e7-edaae414fc6e","typeDefName":"Anchors","typeDefVersion":1},"updateTime":1775025949989,"updatedBy":"Egeria Project","version":1793024468194}],"createTime":1775025949989,"createdBy":"Egeria Project","guid":"d152f4e8-c6ba-424a-8d2c-17ad73dd7e9c","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"e0eabb0c-d3ce-411e-8218-d1de75c354a6","metadataCollectionName":"SecurityContentPack","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"authors":{"class":"ArrayPropertyValue","arrayCount":1,"arrayValues":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"0":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"National Institute of Standards and Technology (NIST)","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"headerVersion":1,"instancePropertyCategory":"ARRAY","typeGUID":"0428b5d3-f824-459c-b7f5-f8151de59707","typeName":"array<string>"},"description":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Establish [Assignment: organization-defined alternate communication paths] for system operations organizational command and control.","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"displayName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"SC-47 Alternate Communications Paths","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"domainIdentifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_INT","primitiveValue":3,"typeGUID":"7fc49104-fd3a-46c8-b6bf-f16b6074cd35","typeName":"int"},"identifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"SC-47","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"qualifiedName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"NIST SP 800-53 Rev 5::SC-47","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"usage":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"An incident, whether adversarial- or nonadversarial-based, can disrupt established communications paths used for system operations and organizational command and control. Alternate communications paths reduce the risk of all communications paths being affected by the same incident. To compound the problem, the inability of organizational officials to obtain timely information about disruptions or to provide timely direction to operational elements after a communications path incident, can impact the ability of the organization to respond to such incidents in a timely manner. Establishing alternate communications paths for command and control purposes, including designating alternative decision makers if primary decision makers are unavailable and establishing the extent and limitations of their actions, can greatly facilitate the organization’s ability to continue to operate and take appropriate actions during an incident.","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"ENTITY_DEF","typeDefGUID":"c794985e-a10b-4b6c-9dc2-6b2e0a2901d3","typeDefName":"GovernanceControl","typeDefVersion":1},"updateTime":1775025949989,"updatedBy":"Egeria Project","version":1793024468194},{"class":"EntityDetail","classifications":[{"class":"Classification","classificationOrigin":"ASSIGNED","createTime":1775025949989,"createdBy":"Egeria Project","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"e0eabb0c-d3ce-411e-8218-d1de75c354a6","metadataCollectionName":"SecurityContentPack","name":"Anchors","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"anchorDomainName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"AuthoredReferenceable","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"anchorTypeName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"GovernanceControl","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"CLASSIFICATION_DEF","typeDefGUID":"aa44f302-2e43-4669-a1e7-edaae414fc6e","typeDefName":"Anchors","typeDefVersion":1},"updateTime":1775025949989,"updatedBy":"Egeria Project","version":1793024468194}],"createTime":1775025949989,"createdBy":"Egeria Project","guid":"1f0a5c29-45b2-47d4-af17-0c740e5cf485","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"e0eabb0c-d3ce-411e-8218-d1de75c354a6","metadataCollectionName":"SecurityContentPack","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"authors":{"class":"ArrayPropertyValue","arrayCount":1,"arrayValues":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"0":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"National Institute of Standards and Technology (NIST)","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"headerVersion":1,"instancePropertyCategory":"ARRAY","typeGUID":"0428b5d3-f824-459c-b7f5-f8151de59707","typeName":"array<string>"},"description":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Relocate [Assignment: organization-defined sensors and monitoring capabilities] to [Assignment: organization-defined locations] under the following conditions or circumstances: [Assignment: organization-defined conditions or circumstances].","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"displayName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"SC-48 Sensor Relocation","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"domainIdentifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_INT","primitiveValue":3,"typeGUID":"7fc49104-fd3a-46c8-b6bf-f16b6074cd35","typeName":"int"},"identifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"SC-48","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"qualifiedName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"NIST SP 800-53 Rev 5::SC-48","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"usage":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Adversaries may take various paths and use different approaches as they move laterally through an organization (including its systems) to reach their target or as they attempt to exfiltrate information from the organization. The organization often only has a limited set of monitoring and detection capabilities, and they may be focused on the critical or likely infiltration or exfiltration paths. By using communications paths that the organization typically does not monitor, the adversary can increase its chances of achieving its desired goals. By relocating its sensors or monitoring capabilities to new locations, the organization can impede the adversary’s ability to achieve its goals. The relocation of the sensors or monitoring capabilities might be done based on threat information that the organization has acquired or randomly to confuse the adversary and make its lateral transition through the system or organization more challenging.","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"ENTITY_DEF","typeDefGUID":"c794985e-a10b-4b6c-9dc2-6b2e0a2901d3","typeDefName":"GovernanceControl","typeDefVersion":1},"updateTime":1775025949989,"updatedBy":"Egeria Project","version":1793024468194},{"class":"EntityDetail","classifications":[{"class":"Classification","classificationOrigin":"ASSIGNED","createTime":1775025949989,"createdBy":"Egeria Project","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"e0eabb0c-d3ce-411e-8218-d1de75c354a6","metadataCollectionName":"SecurityContentPack","name":"Anchors","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"anchorDomainName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"AuthoredReferenceable","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"anchorTypeName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"GovernanceControl","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"CLASSIFICATION_DEF","typeDefGUID":"aa44f302-2e43-4669-a1e7-edaae414fc6e","typeDefName":"Anchors","typeDefVersion":1},"updateTime":1775025949989,"updatedBy":"Egeria Project","version":1793024468194}],"createTime":1775025949989,"createdBy":"Egeria Project","guid":"abeef710-0ae8-45c3-8397-493f562ac55b","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"e0eabb0c-d3ce-411e-8218-d1de75c354a6","metadataCollectionName":"SecurityContentPack","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"authors":{"class":"ArrayPropertyValue","arrayCount":1,"arrayValues":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"0":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"National Institute of Standards and Technology (NIST)","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"headerVersion":1,"instancePropertyCategory":"ARRAY","typeGUID":"0428b5d3-f824-459c-b7f5-f8151de59707","typeName":"array<string>"},"description":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Dynamically relocate [Assignment: organization-defined sensors and monitoring capabilities] to [Assignment: organization-defined locations] under the following conditions or circumstances: [Assignment: organization-defined conditions or circumstances].","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"displayName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"SC-48(1) Dynamic Relocation of Sensors or Monitoring Capabilities","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"domainIdentifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIM