ionProcess","status":"ACTIVE_TYPEDEF"},"validInstanceStatusList":["ACTIVE","DELETED"],"version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EntityDef","category":"ENTITY_DEF","createTime":1769277597779,"createdBy":"Egeria","description":"A governance action process that is used to extract metadata from an external source and catalog it in the open metadata repository.","descriptionGUID":"cb0e7ee1-f409-4e4c-897e-ce1607018535","descriptionWiki":"https://egeria-project.org/types/4/0462-Governance-Action-Processes/","guid":"d2bc1437-26da-49a5-9eab-1b0984b911bd","headerVersion":1,"initialStatus":"ACTIVE","name":"CataloguingActionProcess","origin":"bce3b0a0-662a-4f87-b8dc-844078a11a6e","status":"ACTIVE_TYPEDEF","superType":{"guid":"4d3a2b8d-9e2e-4832-b338-21c74e45b238","headerVersion":1,"name":"GovernanceActionProcess","status":"ACTIVE_TYPEDEF"},"validInstanceStatusList":["ACTIVE","DELETED"],"version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EntityDef","category":"ENTITY_DEF","createTime":1769277597779,"createdBy":"Egeria","description":"A governance action process that is used to explore a digital resource to understand an overview of its content and context.","descriptionGUID":"063005b5-ef49-433c-9ad1-e8d590dd91f6","descriptionWiki":"https://egeria-project.org/types/4/0462-Governance-Action-Processes/","guid":"d50102d3-05b4-48f1-8441-a995dfa31c5c","headerVersion":1,"initialStatus":"ACTIVE","name":"ExploringActionProcess","origin":"bce3b0a0-662a-4f87-b8dc-844078a11a6e","status":"ACTIVE_TYPEDEF","superType":{"guid":"4d3a2b8d-9e2e-4832-b338-21c74e45b238","headerVersion":1,"name":"GovernanceActionProcess","status":"ACTIVE_TYPEDEF"},"validInstanceStatusList":["ACTIVE","DELETED"],"version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EntityDef","category":"ENTITY_DEF","createTime":1769277597779,"createdBy":"Egeria","description":"A governance action process that is used to survey a digital resource to deeply understand its content and context.","descriptionGUID":"71b48b95-de28-4986-be9e-e33bdf4a4637","descriptionWiki":"https://egeria-project.org/types/4/0462-Governance-Action-Processes/","guid":"b84b118e-7ca9-496c-9d4f-74b3a9630fad","headerVersion":1,"initialStatus":"ACTIVE","name":"SurveyingActionProcess","origin":"bce3b0a0-662a-4f87-b8dc-844078a11a6e","status":"ACTIVE_TYPEDEF","superType":{"guid":"4d3a2b8d-9e2e-4832-b338-21c74e45b238","headerVersion":1,"name":"GovernanceActionProcess","status":"ACTIVE_TYPEDEF"},"validInstanceStatusList":["ACTIVE","DELETED"],"version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EntityDef","category":"ENTITY_DEF","createTime":1769277597779,"createdBy":"Egeria","description":"A governance action process that is used to provision a digital resource to a target environment.","descriptionGUID":"dfb1c8ea-e7ac-4720-8a39-1c111ff47845","descriptionWiki":"https://egeria-project.org/types/4/0462-Governance-Action-Processes/","guid":"c010a7df-ac08-4ad6-ac86-c9292fae2961","headerVersion":1,"initialStatus":"ACTIVE","name":"ProvisioningActionProcess","origin":"bce3b0a0-662a-4f87-b8dc-844078a11a6e","status":"ACTIVE_TYPEDEF","superType":{"guid":"4d3a2b8d-9e2e-4832-b338-21c74e45b238","headerVersion":1,"name":"GovernanceActionProcess","status":"ACTIVE_TYPEDEF"},"validInstanceStatusList":["ACTIVE","DELETED"],"version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EntityDef","category":"ENTITY_DEF","createTime":1769277597779,"createdBy":"Egeria","description":"A governance action process that is used to delete requested metadata elements.","descriptionGUID":"49dfe212-e862-4ef2-9971-a6400f7f7a77","descriptionWiki":"https://egeria-project.org/types/4/0462-Governance-Action-Processes/","guid":"c4b4d207-70be-4fd0-b78e-a84d5bf58391","headerVersion":1,"initialStatus":"ACTIVE","name":"DeletingActionProcess","origin":"bce3b0a0-662a-4f87-b8dc-844078a11a6e","status":"ACTIVE_TYPEDEF","superType":{"guid":"4d3a2b8d-9e2e-4832-b338-21c74e45b238","headerVersion":1,"name":"GovernanceActionProcess","status":"ACTIVE_TYPEDEF"},"validInstanceStatusList":["ACTIVE","DELETED"],"version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EntityDef","category":"ENTITY_DEF","createTime":1769277597779,"createdBy":"Egeria","description":"A governance action process that is used to create a subscription to a digital resource.","descriptionGUID":"2771d39d-1b12-448d-b5ab-0adf8b078322","descriptionWiki":"https://egeria-project.org/types/4/0462-Governance-Action-Processes/","guid":"d3847402-c3ad-493e-946a-506205b765f8","headerVersion":1,"initialStatus":"ACTIVE","name":"SubscribingActionProcess","origin":"bce3b0a0-662a-4f87-b8dc-844078a11a6e","status":"ACTIVE_TYPEDEF","superType":{"guid":"4d3a2b8d-9e2e-4832-b338-21c74e45b238","headerVersion":1,"name":"GovernanceActionProcess","status":"ACTIVE_TYPEDEF"},"validInstanceStatusList":["ACTIVE","DELETED"],"version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EntityDef","category":"ENTITY_DEF","createTime":1769277597779,"createdBy":"Egeria","description":"A set of properties describing the level of activity around a code repository like GitHub.","descriptionGUID":"0cd374d8-ae62-4172-b790-9844a6906f49","descriptionWiki":"https://egeria-project.org/types/6/0680-Code-Analysis/","guid":"9cd23886-02e3-4e8d-bf45-0d72e2dd944d","headerVersion":1,"initialStatus":"ACTIVE","name":"ContributorAnalysisAnnotation","origin":"bce3b0a0-662a-4f87-b8dc-844078a11a6e","propertiesDefinition":[{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"The minimum number of team members that have to suddenly disappear from a project before the project stalls due to lack of knowledgeable or competent personnel.","attributeDescriptionGUID":"5790f24f-0b85-4278-b431-67433d15cf95","attributeName":"busFactor","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"7fc49104-fd3a-46c8-b6bf-f16b6074cd35","headerVersion":1,"name":"int","primitiveDefCategory":"OM_PRIMITIVE_TYPE_INT","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"The number of distinct contributors to the repository during its lifetime.","attributeDescriptionGUID":"e31b451c-5f18-4d38-9f67-46fcdb5cabae","attributeName":"totalContributorCount","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"33a91510-92ee-4825-9f49-facd7a6f9db6","headerVersion":1,"name":"long","primitiveDefCategory":"OM_PRIMITIVE_TYPE_LONG","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"The number of distinct contributors to the repository in the last year.","attributeDescriptionGUID":"12820701-5f9a-4c76-9917-b2a0749c0de4","attributeName":"activeContributorCount","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"33a91510-92ee-4825-9f49-facd7a6f9db6","headerVersion":1,"name":"long","primitiveDefCategory":"OM_PRIMITIVE_TYPE_LONG","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"The number of commits to the repository during its lifetime.","attributeDescriptionGUID":"7e27e23e-225e-4d61-8cda-c3d05bd51579","attributeName":"commitCount","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"33a91510-92ee-4825-9f49-facd7a6f9db6","headerVersion":1,"name":"long","primitiveDefCategory":"OM_PRIMITIVE_TYPE_LONG","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"The number of commits to the repository in the last year.","attributeDescriptionGUID":"ae39cbe2-abf0-4147-910e-6839c1941868",