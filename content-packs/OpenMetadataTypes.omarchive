ions that have been identified for this element.","attributeName":"actionsForTarget","entityType":{"guid":"95261f26-8fe0-4723-b953-4ae5789ec639","headerVersion":1,"name":"Action","status":"ACTIVE_TYPEDEF"},"headerVersion":1},"endDef2":{"attributeCardinality":"ANY_NUMBER","attributeDescription":"Elements that will be updated or used to complete the action.","attributeName":"actionTargets","entityType":{"guid":"4e7761e8-3969-4627-8f40-bfe3cde85a1d","headerVersion":1,"name":"OpenMetadataRoot","status":"ACTIVE_TYPEDEF"},"headerVersion":1},"guid":"207e2594-e3e4-4be8-a12c-4c401656e241","headerVersion":1,"initialStatus":"ACTIVE","multiLink":false,"name":"ActionTarget","origin":"bce3b0a0-662a-4f87-b8dc-844078a11a6e","propagationRule":"NONE","propertiesDefinition":[{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"The name to identify the action target to the actor that processes it.","attributeDescriptionGUID":"3a5d325f-267c-4821-beb2-2c59d89891ed","attributeName":"actionTargetName","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","headerVersion":1,"name":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Defines the current execution status of a process.","attributeDescriptionGUID":"c2d8fd79-0c16-4e01-888f-2ae7a9cdf11d","attributeName":"activityStatus","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"description":"The description of the activity has been created and is pending.","descriptionGUID":"12daebe5-544c-4968-b5f1-583f52ba7f25","headerVersion":1,"ordinal":0,"value":"REQUESTED"},"description":"Defines the current execution status of a process.","descriptionGUID":"eb7bba16-b2a0-4e7d-b249-f0be30a50171","descriptionWiki":"https://egeria-project.org/types/0/0010-Base-Model/","elementDefs":[{"description":"The description of the activity has been created and is pending.","descriptionGUID":"12daebe5-544c-4968-b5f1-583f52ba7f25","headerVersion":1,"ordinal":0,"value":"REQUESTED"},{"description":"The activity is approved to run. This means that the mandatory preconditions have been satisfied.","descriptionGUID":"623a7b7a-1f5a-403b-b437-e60e66ffea59","headerVersion":1,"ordinal":1,"value":"APPROVED"},{"description":"The activity is waiting for its start time or an actor to claim it.","descriptionGUID":"236c4a55-030b-4e78-ab41-ba54921bb11a","headerVersion":1,"ordinal":2,"value":"WAITING"},{"description":"The process that will perform the activity is being activated.","descriptionGUID":"0f805c52-f05a-44ac-b785-cc705285794a","headerVersion":1,"ordinal":3,"value":"ACTIVATING"},{"description":"The work for the activity is in progress.","descriptionGUID":"c0568205-7adc-4104-a627-7d584a0cb60b","headerVersion":1,"ordinal":4,"value":"IN_PROGRESS"},{"description":"The work for the activity has been paused.","descriptionGUID":"a93da12b-2bb8-4dc9-a36c-3b654bcb189b","headerVersion":1,"ordinal":5,"value":"PAUSED"},{"description":"The activity is designed to provide important information to the various actors.","descriptionGUID":"1a98344b-f43f-4bff-9604-323f18a999af","headerVersion":1,"ordinal":6,"value":"FOR_INFO"},{"description":"The work for the activity has successfully completed.","descriptionGUID":"3bc841d3-8e51-475c-9283-ee9c8b7e8670","headerVersion":1,"ordinal":10,"value":"COMPLETED"},{"description":"The activity has not happened because it is not appropriate (for example, created by an automated process as a result of a false positive).","descriptionGUID":"6a493851-c089-45a8-877f-c3e98d863c52","headerVersion":1,"ordinal":11,"value":"INVALID"},{"description":"The activity has not been actioned because it is not important, or another activity has superseded it.","descriptionGUID":"5e7c9514-b303-4710-8869-af30b8e10140","headerVersion":1,"ordinal":12,"value":"IGNORED"},{"description":"The process that is performing the work (normally an automated process) failed during start up or execution.","descriptionGUID":"848d072a-a497-49e9-96c4-af61d3ffbebb","headerVersion":1,"ordinal":13,"value":"FAILED"},{"description":"The activity was cancelled by an external caller.","descriptionGUID":"80ee5577-a0eb-4c18-8b12-0d4f5606851a","headerVersion":1,"ordinal":14,"value":"CANCELLED"},{"description":"The activity was abandoned because it is no longer relevant.  Some work may have occurred but is what stopped, probably in an incomplete state.","descriptionGUID":"2911bd8f-4993-4968-b12b-1eade7987093","headerVersion":1,"ordinal":15,"value":"ABANDONED"},{"description":"Undefined or user-defined status.","descriptionGUID":"1e67023c-4ae4-4f69-b16e-b5e0290641dc","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"a6e698b0-a4f7-4a39-8c80-db0bb0f972e","headerVersion":1,"name":"ActivityStatus","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Time that a transient process started.","attributeDescriptionGUID":"f2c4180f-a803-42d6-9eb1-2bd29bd20d88","attributeName":"startTime","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"1bef35ca-d4f9-48db-87c2-afce4649362d","headerVersion":1,"name":"date","primitiveDefCategory":"OM_PRIMITIVE_TYPE_DATE","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"When the requested activity was completed.","attributeDescriptionGUID":"9359f36f-ed11-4c33-80c3-e02941fee6b5","attributeName":"completionTime","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","