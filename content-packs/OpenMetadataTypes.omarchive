y":"AT_MOST_ONE","attributeDescription":"A symbol, such as a pictogram, logogram, ideogram, or smiley embedded in text and used in electronic messages and web pages. The primary function of modern emoji is to fill in emotional cues otherwise missing from typed conversation as well as to replace words as part of a logographic system. Emoji exist in various genres, including facial expressions, expressions, activity, food and drinks, celebrations, flags, objects, symbols, places, types of weather, animals, and nature.","attributeDescriptionGUID":"9e40ae6d-99f4-4336-a043-e1fac95e7ed6","attributeName":"emoji","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","headerVersion":1,"name":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0}],"status":"ACTIVE_TYPEDEF","superType":{"guid":"4e7761e8-3969-4627-8f40-bfe3cde85a1d","headerVersion":1,"name":"OpenMetadataRoot","status":"ACTIVE_TYPEDEF"},"validInstanceStatusList":["ACTIVE","DELETED"],"version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EntityDef","category":"ENTITY_DEF","createTime":1577886131090,"createdBy":"ODPi Egeria","description":"A descriptive tag for an item.","descriptionGUID":"74bf2e98-b334-4cc8-b89f-a03239a7b574","descriptionWiki":"https://egeria-project.org/types/1/0150-Feedback/","guid":"ba846a7b-2955-40bf-952b-2793ceca090a","headerVersion":1,"initialStatus":"ACTIVE","name":"InformalTag","origin":"bce3b0a0-662a-4f87-b8dc-844078a11a6e","propertiesDefinition":[{"attributeCardinality":"ONE_ONLY","attributeDescription":"Display name of the element used for summary tables and titles.","attributeDescriptionGUID":"a42ceece-6cd8-4c71-9920-e3c96df3c8bb","attributeName":"displayName","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid"