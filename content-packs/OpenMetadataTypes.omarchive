Count":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Date/time that work started on this element.","attributeDescriptionGUID":"e3e374cc-0f9d-45f6-ae74-7d7a438b17bf","attributeName":"startDate","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"1bef35ca-d4f9-48db-87c2-afce4649362d","headerVersion":1,"name":"date","primitiveDefCategory":"OM_PRIMITIVE_TYPE_DATE","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Describes how frequently the processing should run - in minutes.","attributeDescriptionGUID":"d261dc24-a26f-460f-808d-11b586c8ca7a","attributeName":"refreshTimeInterval","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"33a91510-92ee-4825-9f49-facd7a6f9db6","headerVersion":1,"name":"long","primitiveDefCategory":"OM_PRIMITIVE_TYPE_LONG","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Latest time that the connector can run.","attributeDescriptionGUID":"ec798c83-660d-400e-8fa8-00dc8634fe24","attributeName":"connectorShutdownDate","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"1bef35ca-d4f9-48db-87c2-afce4649362d","headerVersion":1,"name":"date","primitiveDefCategory":"OM_PRIMITIVE_TYPE_DATE","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Should the service/connector create integration reports based on its activity? (Default is true.)","attributeDescriptionGUID":"61f01f63-2e2d-47d0-9ea7-a95c0d561194","attributeName":"generateConnectorActivityReports","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"3863f010-611c-41fe-aaae-5d4d427f863b","headerVersion":1,"name":"boolean","primitiveDefCategory":"OM_PRIMITIVE_TYPE_BOOLEAN","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Defines the permitted directions of flow of metadata updates between open metadata and a third party technology.","attributeDescriptionGUID":"a1c8581e-ed5d-457d-a069-f847f28597d6","attributeName":"permittedSynchronization","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"description":"Metadata exchange is permitted in both directions.  Synchronization is halted on a specific element if potentially clashing updates have occurred both in the third party technology and open metadata.  Such conflicts are logged on the audit log and resolved through manual stewardship.","descriptionGUID":"3ecbbab2-8c60-49be-97cd-be1d0bca49e9","headerVersion":1,"ordinal":0,"value":"BOTH_DIRECTIONS"},"description":"Defines the permitted direction of exchange of metadata with a third party technology.","descriptionGUID":"c6233ba5-1438-4391-90c5-569d1f54746e","descriptionWiki":"https://egeria-project.org/types/0/0017-External-Identifiers/","elementDefs":[{"description":"Metadata exchange is permitted in both directions.  Synchronization is halted on a specific element if potentially clashing updates have occurred both in the third party technology and open metadata.  Such conflicts are logged on the audit log and resolved through manual stewardship.","descriptionGUID":"3ecbbab2-8c60-49be-97cd-be1d0bca49e9","headerVersion":1,"ordinal":0,"value":"BOTH_DIRECTIONS"},{"description":"The third party technology is logically downstream of open metadata.  This means the open metadata ecosystem is the originator and owner of the metadata being synchronized. Any updates detected in the third technology are overridden by the latest open metadata values.","descriptionGUID":"7fe0046d-8b1a-4931-b9b7-18279c6f449a","headerVersion":1,"ordinal":1,"value":"TO_THIRD_PARTY"},{"description":"The third party technology is logically upstream (the originator and owner of the metadata).  Any updates made in open metadata are not passed to the third party technology and the third party technology is requested to refresh the open metadata version.","descriptionGUID":"9ed53b29-f843-4af2-b510-44683d84b2d0","headerVersion":1,"ordinal":2,"value":"FROM_THIRD_PARTY"},{"description":"Another type of synchronization rule - see description property.","descriptionGUID":"332853a9-af08-4210-a9dd-48e40db5ee09","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"973a9f4c-93fa-43a5-a0c5-d97dbd164e78","headerVersion":1,"name":"PermittedSynchronization","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0}],"status":"ACTIVE_TYPEDEF","validInstanceStatusList":["ACTIVE","DELETED"],"version":1,"versionName":"6.2-SNAPSHOT"},{"class":"RelationshipDef","category":"RELATIONSHIP_DEF","createTime":1588261366992,"createdBy":"Egeria","description":"Identifies an element that an integration connector is to work with.","descriptionGUID":"0e976ec0-1a01-49a4-85f2-49b96b4203df","descriptionWiki":"https://egeria-project.org/types/4/0464-Dynamic-Integration-Groups/","endDef1":{"attributeCardinality":"ANY_NUMBER","attributeDescription":"An integration connector managing metadata synchronization.","attributeName":"refreshedByConnectors","entityType":{"guid":"759da11b-ebb6-4382-bdc9-72adc7c922db","headerVersion":1,"name":"IntegrationConnector","status":"ACTIVE_TYPEDEF"},"headerVersion":1},"endDef2":{"attributeCardinality":"ANY_NUMBER","attributeDescription":"An open metadata element that the integration connector is working on.","attribute