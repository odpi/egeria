TE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","headerVersion":1,"name":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Details of the organization, person or process that created the element, or provided the information used to create the element.","attributeDescriptionGUID":"9c40c4e3-1d6d-45fd-8df0-f1a2e09db636","attributeName":"source","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","headerVersion":1,"name":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Timestamp documenting the last time the metadata in the external metadata source was synchronized with open metadata element.","attributeDescriptionGUID":"45f5f2fc-17ec-4f02-8d7a-8cfe8f1557fe","attributeName":"lastSynchronized","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"1bef35ca-d4f9-48db-87c2-afce4649362d","headerVersion":1,"name":"date","primitiveDefCategory":"OM_PRIMITIVE_TYPE_DATE","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Additional properties to aid the mapping to the the element in an external resource.","attributeDescriptionGUID":"8161e120-993b-490c-bf66-cb9fd85192fc","attributeName":"mappingProperties","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"CollectionDef","argumentCount":2,"argumentTypes":["OM_PRIMITIVE_TYPE_STRING","OM_PRIMITIVE_TYPE_STRING"],"category":"COLLECTION","collectionDefCategory":"OM_COLLECTION_MAP","description":"A map from string to string.","descriptionGUID":"f285d0ca-50ab-4564-b129-c7e3ba4e8545","guid":"005c7c14-ac84-4136-beed-959401b041f8","headerVersion":1,"name":"map<string,string>","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Defines the permitted directions of flow of metadata updates between open metadata and a third party technology.","attributeDescriptionGUID":"a1c8581e-ed5d-457d-a069-f847f28597d6","attributeName":"permittedSynchronization","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"description":"Metadata exchange is permitted in both directions.  Synchronization is halted on a specific element if potentially clashing updates have occurred both in the third party technology and open metadata.  Such conflicts are logged on the audit log and resolved through manual stewardship.","descriptionGUID":"3ecbbab2-8c60-49be-97cd-be1d0bca49e9","headerVersion":1,"ordinal":0,"value":"BOTH_DIRECTIONS"},"description":"Defines the permitted direction of exchange of metadata with a third party technology.","descriptionGUID":"c6233ba5-1438-4391-90c5-569d1f54746e","descriptionWiki":"https://egeria-project.org/types/0/0017-External-Identifiers/","elementDefs":[{"description":"Metadata exchange is permitted in both directions.  Synchronization is halted on a specific element if potentially clashing updates have occurred both in the third party technology and open metadata.  Such conflicts are logged on the audit log and resolved through manual stewardship.","descriptionGUID":"3ecbbab2-8c60-49be-97cd-be1d0bca49e9","headerVersion":1,"ordinal":0,"value":"BOTH_DIRECTIONS"},{"description":"The third party technology is logically downstream of open metadata.  This means the open metadata ecosystem is the originator and owner of the metadata being synchronized. Any updates detected in the third technology are overridden by the latest open metadata values.","descriptionGUID":"7fe0046d-8b1a-4931-b9b7-18279c6f449a","headerVersion":1,"ordinal":1,"value":"TO_THIRD_PARTY"},{"description":"The third party technology is logically upstream (the originator and owner of the metadata).  Any updates made in open metadata are not passed to the third party technology and the third party technology is requested to refresh the open metadata version.","descriptionGUID":"9ed53b29-f843-4af2-b510-44683d84b2d0","headerVersion":1,"ordinal":2,"value":"FROM_THIRD_PARTY"},{"description":"Another type of synchronization rule - see description property.","descriptionGUID":"332853a9-af08-4210-a9dd-48e40db5ee09","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"973a9f4c-93fa-43a5-a0c5-d97dbd164e78","headerVersion":1,"name":"PermittedSynchronization","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0}],"status":"ACTIVE_TYPEDEF","validInstanceStatusList":["ACTIVE","DELETED"],"version":1,"versionName":"6.2-SNAPSHOT"},{"class":"RelationshipDef","category":"RELATIONSHIP_DEF","createTime":1577886131090,"createdBy":"ODPi Egeria","description":"Link to indicate that a referenceable provides additional information about another referenceable.","descriptionGUID":"2d3f4815-d8e7-44c3-88cc-f587cfe26e70","descriptionWiki":"https://egeria-project.org/types/0/0019-More-Information/","endDef1":{"attributeCardinality":"ANY_NUMBER","attributeDescription":"Describes this core element.","attributeName":"describes","entityType":{"guid":"a32316b8-dc8c-48c5-b12b-71c1b2a080bf","headerVersion":1,"name":"Referenceable","status":"ACTIVE_TYPEDEF"},"headerVersion":1},"endDef2":{"attributeCardinality":"ANY_NUMBER","attributeDescription":"Provides more information about this referenceable.","attribu