-4f52-84e4-284d40d6a453","attributeName":"scheduler","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","headerVersion":1,"name":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Expression used to create the annotation.","attributeDescriptionGUID":"e130bc01-7c58-4799-8d8a-ae3ec659a064","attributeName":"expression","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","headerVersion":1,"name":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"The name of the engine that runs a custom data quality check, for example soda or great-expectations.","attributeDescriptionGUID":"bb603228-0b5f-4073-ba68-92866e27816d","attributeName":"qualityEngine","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","headerVersion":1,"name":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"The operator used to compare the measured value with the threshold values, for example mustBe, mustNotBe, mustBeGreaterThan, mustBeGreaterOrEqualTo, mustBeLessThan, mustBeLessOrEqualTo, mustBeBetween or mustNotBeBetween.","attributeDescriptionGUID":"0d319153-8edd-42d0-97e6-eae70daea355","attributeName":"comparisonOperator","attributeStat