{"class":"OpenMetadataArchive","archiveProperties":{"class":"OpenMetadataArchiveProperties","archiveDescription":"Standard types for open metadata repositories.","archiveGUID":"bce3b0a0-662a-4f87-b8dc-844078a11a6e","archiveName":"Open Metadata Types","archiveType":"CONTENT_PACK","archiveVersion":"6.2-SNAPSHOT","creationDate":1769277597779,"originatorLicense":"Apache-2.0","originatorName":"Egeria"},"archiveTypeStore":{"class":"OpenMetadataArchiveTypeStore","attributeTypeDefs":[{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"1c4b21f4-0b67-41a7-a6ed-2af185eb9b3b","headerVersion":1,"name":"object","primitiveDefCategory":"OM_PRIMITIVE_TYPE_UNKNOWN","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"3863f010-611c-41fe-aaae-5d4d427f863b","headerVersion":1,"name":"boolean","primitiveDefCategory":"OM_PRIMITIVE_TYPE_BOOLEAN","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"6b7d410a-2e8a-4d12-981a-a806449f9bdb","headerVersion":1,"name":"byte","primitiveDefCategory":"OM_PRIMITIVE_TYPE_BYTE","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"b0abebe5-cf85-4065-86ad-f3c6360ed9c7","headerVersion":1,"name":"char","primitiveDefCategory":"OM_PRIMITIVE_TYPE_CHAR","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"8e95b966-ab60-46d4-a03f-40c5a1ba6c2a","headerVersion":1,"name":"short","primitiveDefCategory":"OM_PRIMITIVE_TYPE_SHORT","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"7fc49104-fd3a-46c8-b6bf-f16b6074cd35","headerVersion":1,"name":"int","primitiveDefCategory":"OM_PRIMITIVE_TYPE_INT","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"33a91510-92ee-4825-9f49-facd7a6f9db6","headerVersion":1,"name":"long","primitiveDefCategory":"OM_PRIMITIVE_TYPE_LONG","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"52aeb769-37b7-4b30-b949-ddc7dcebcfa2","headerVersion":1,"name":"float","primitiveDefCategory":"OM_PRIMITIVE_TYPE_FLOAT","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"e13572e8-25c3-4994-acb6-2ea66c95812e","headerVersion":1,"name":"double","primitiveDefCategory":"OM_PRIMITIVE_TYPE_DOUBLE","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"8aa56e52-1076-4e0d-9b66-3873a1ed7392","headerVersion":1,"name":"biginteger","primitiveDefCategory":"OM_PRIMITIVE_TYPE_BIGINTEGER","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"d5c8ad9f-8fee-4a64-80b3-63ce1e47f6bb","headerVersion":1,"name":"bigdecimal","primitiveDefCategory":"OM_PRIMITIVE_TYPE_BIGDECIMAL","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","headerVersion":1,"name":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"1bef35ca-d4f9-48db-87c2-afce4649362d","headerVersion":1,"name":"date","primitiveDefCategory":"OM_PRIMITIVE_TYPE_DATE","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"CollectionDef","argumentCount":2,"argumentTypes":["OM_PRIMITIVE_TYPE_STRING","OM_PRIMITIVE_TYPE_STRING"],"category":"COLLECTION","collectionDefCategory":"OM_COLLECTION_MAP","description":"A map from string to string.","descriptionGUID":"f285d0ca-50ab-4564-b129-c7e3ba4e8545","guid":"005c7c14-ac84-4136-beed-959401b041f8","headerVersion":1,"name":"map<string,string>","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"CollectionDef","argumentCount":2,"argumentTypes":["OM_PRIMITIVE_TYPE_STRING","OM_PRIMITIVE_TYPE_BOOLEAN"],"category":"COLLECTION","collectionDefCategory":"OM_COLLECTION_MAP","description":"A map from string to Boolean.","descriptionGUID":"72d76e44-350c-4ff3-baae-54b837f723c7","guid":"8fa603dd-c2c5-43fc-8ff4-92141f2414ab","headerVersion":1,"name":"map<string,boolean>","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"CollectionDef","argumentCount":2,"argumentTypes":["OM_PRIMITIVE_TYPE_STRING","OM_PRIMITIVE_TYPE_INT"],"category":"COLLECTION","collectionDefCategory":"OM_COLLECTION_MAP","description":"A map from string to int.","descriptionGUID":"47373fd6-be40-439b-97ca-881878eed1f4","guid":"8fa603dd-c2c5-43fc-8ff4-92141f2414ac","headerVersion":1,"name":"map<string,int>","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"CollectionDef","argumentCount":2,"argumentTypes":["OM_PRIMITIVE_TYPE_STRING","OM_PRIMITIVE_TYPE_LONG"],"category":"COLLECTION","collectionDefCategory":"OM_COLLECTION_MAP","description":"A map from string to long.","descriptionGUID":"039b3466-e28b-4c73-8181-d9a57749c706","guid":"8fa603dd-c2c5-43fc-8ff4-92141f2414ae","headerVersion":1,"name":"map<string,long>","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"CollectionDef","argumentCount":2,"argumentTypes":["OM_PRIMITIVE_TYPE_STRING","OM_PRIMITIVE_TYPE_DOUBLE"],"category":"COLLECTION","collectionDefCategory":"OM_COLLECTION_MAP","description":"A map from string to double.","descriptionGUID":"ee2cf3d5-3ff8-4d6a-82ed-35c0123dcc89","guid":"17211869-ed39-4ba9-bead-ffd967df65a8","headerVersion":1,"name":"map<string,double>","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"CollectionDef","argumentCount":2,"argumentTypes":["OM_PRIMITIVE_TYPE_STRING","OM_PRIMITIVE_TYPE_DATE"],"category":"COLLECTION","collectionDefCategory":"OM_COLLECTION_MAP","description":"A map from string to date.","descriptionGUID":"978b8ad1-c7c8-4892-bd83-98c9f07e8028","guid":"ee293c68-e34d-4885-a512-f927d35a5893","headerVersion":1,"name":"map<string,date>","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"CollectionDef","argumentCount":2,"argumentTypes":["OM_PRIMITIVE_TYPE_STRING","OM_PRIMITIVE_TYPE_UNKNOWN"],"category":"COLLECTION","collectionDefCategory":"OM_COLLECTION_MAP","description":"A map from string to object.","descriptionGUID":"6dd2944b-9107-41c6-a10b-6a938fd6f2f5","guid":"8fa603dd-c2c5-43fc-8ff4-92141f2414ad","headerVersion":1,"name":"map<string,object>","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"CollectionDef","argumentCount":1,"argumentTypes":["OM_PRIMITIVE_TYPE_STRING"],"category":"COLLECTION","collectionDefCategory":"OM_COLLECTION_ARRAY","description":"An array of strings.","descriptionGUID":"4a384611-d8c1-4909-a6f8-1385ffe210e2","guid":"0428b5d3-f824-459c-b7f5-f8151de59707","headerVersion":1,"name":"array<string>","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"CollectionDef","argumentCount":1,"argumentTypes":["OM_PRIMITIVE_TYPE_INT"],"category":"COLLECTION","collectionDefCategory":"OM_COLLECTION_ARRAY","description":"An array of integers.","descriptionGUID":"ac772d8b-278e-4017-a7e8-1988c74c091e","guid":"0103fe10-98b0-4910-8ee0-21d529f7ff6d","headerVersion":1,"name":"array<int>","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"description":"The description of the activity has been created and is pending.","descriptionGUID":"12daebe5-544c-4968-b5f1-583f52ba7f25","headerVersion":1,"ordinal":0,"value":"REQUESTED"},"description":"Defines the current execution status of a process.","descriptionGUID":"eb7bba16-b2a0-4e7d-b249-f0be30a50171","descriptionWiki":"https://egeria-project.org/types/0/0010-Base-Model/","elementDefs":[{"description":"The description of the activity has been created and is pending.","descriptionGUID":"12daebe5-544c-4968-b5f1-583f52ba7f25","headerVersion":1,"ordinal":0,"value":"REQUESTED"},{"description":"The activity is approved to run. This means that the mandatory preconditions have been satisfied.","descriptionGUID":"623a7b7a-1f5a-403b-b437-e60e66ffea59","headerVersion":1,"ordinal":1,"value":"APPROVED"},{"description":"The activity is waiting for its start time or an actor to claim it.","descriptionGUID":"236c4a55-030b-4e78-ab41-ba54921bb11a","headerVersion":1,"ordinal":2,"value":"WAITING"},{"description":"The process that will perform the activity is being activated.","descriptionGUID":"0f805c52-f05a-44ac-b785-cc705285794a","headerVersion":1,"ordinal":3,"value":"ACTIVATING"},{"description":"The work for the activity is in progress.","descriptionGUID":"c0568205-7adc-4104-a627-7d584a0cb60b","headerVersion":1,"ordinal":4,"value":"IN_PROGRESS"},{"description":"The work for the activity has been paused.","descriptionGUID":"a93da12b-2bb8-4dc9-a36c-3b654bcb189b","headerVersion":1,"ordinal":5,"value":"PAUSED"},{"description":"The activity is designed to provide important information to the various actors.","descriptionGUID":"1a98344b-f43f-4bff-9604-323f18a999af","headerVersion":1,"ordinal":6,"value":"FOR_INFO"},{"description":"The work for the activity has successfully completed.","descriptionGUID":"3bc841d3-8e51-475c-9283-ee9c8b7e8670","headerVersion":1,"ordinal":10,"value":"COMPLETED"},{"description":"The activity has not happened because it is not appropriate (for example, created by an automated process as a result of a false positive).","descriptionGUID":"6a493851-c089-45a8-877f-c3e98d863c52","headerVersion":1,"ordinal":11,"value":"INVALID"},{"description":"The activity has not been actioned because it is not important, or another activity has superseded it.","descriptionGUID":"5e7c9514-b303-4710-8869-af30b8e10140","headerVersion":1,"ordinal":12,"value":"IGNORED"},{"description":"The process that is performing the work (normally an automated process) failed during start up or execution.","descriptionGUID":"848d072a-a497-49e9-96c4-af61d3ffbebb","headerVersion":1,"ordinal":13,"value":"FAILED"},{"description":"The activity was cancelled by an external caller.","descriptionGUID":"80ee5577-a0eb-4c18-8b12-0d4f5606851a","headerVersion":1,"ordinal":14,"value":"CANCELLED"},{"description":"The activity was abandoned because it is no longer relevant.  Some work may have occurred but is what stopped, probably in an incomplete state.","descriptionGUID":"2911bd8f-4993-4968-b12b-1eade7987093","headerVersion":1,"ordinal":15,"value":"ABANDONED"},{"description":"Undefined or user-defined status.","descriptionGUID":"1e67023c-4ae4-4f69-b16e-b5e0290641dc","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"a6e698b0-a4f7-4a39-8c80-db0bb0f972e","headerVersion":1,"name":"ActivityStatus","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"headerVersion":1,"ordinal":99},"description":"Defines the current status of an authored referenceable.","descriptionGUID":"034dbb1b-9f95-4c57-8d83-28bb435e6584","descriptionWiki":"https://egeria-project.org/types/0/0010-Base-Model/","elementDefs":[{"description":"The content is incomplete.","descriptionGUID":"44084c0e-f893-4a6b-b364-c48f50338702","headerVersion":1,"ordinal":0,"value":"DRAFT"},{"description":"The content is ready for review.","descriptionGUID":"bc8fe5f2-d605-4c05-9054-d37ac9fe2811","headerVersion":1,"ordinal":1,"value":"PREPARED"},{"description":"The content is in review.","descriptionGUID":"f376157b-a596-4b83-946b-d7c0e4aadefd","headerVersion":1,"ordinal":2,"value":"PROPOSED"},{"description":"The content is approved.","descriptionGUID":"48c5d720-1001-421a-ba13-634c946bc605","headerVersion":1,"ordinal":3,"value":"APPROVED"},{"description":"The request or proposal is rejected.","descriptionGUID":"cf9ce6fb-d90a-4cb1-8c05-82fed71640e8","headerVersion":1,"ordinal":4,"value":"REJECTED"},{"description":"The instance is approved and in use.","descriptionGUID":"9be9aaee-f394-4342-83ed-ba29cc107398","headerVersion":1,"ordinal":5,"value":"ACTIVE"},{"description":"The instance is out of date and should not be used.","descriptionGUID":"c831d2a8-0b08-45ae-930d-e19038e7e1b1","headerVersion":1,"ordinal":6,"value":"DEPRECATED"},{"description":"The instance is no longer active and must not be used.","descriptionGUID":"a833d2a8-0b08-45ae-930d-e10038e8e1b1","headerVersion":1,"ordinal":7,"value":"OBSOLETE"},{"description":"The instance is in a locally defined state.","descriptionGUID":"2fd04d45-d6f2-4008-a679-42f7326f9b01","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"49f2808c-b5c8-48a9-8a36-672f9ea9a45f","headerVersion":1,"name":"ContentStatus","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"headerVersion":1,"ordinal":99},"description":"Defines the current status of an infrastructure element.","descriptionGUID":"25d51c94-1be1-4504-a58e-f9ca230b309f","descriptionWiki":"https://egeria-project.org/types/0/0010-Base-Model/","elementDefs":[{"description":"The content is in review.","descriptionGUID":"d94fa65e-6104-4770-ab76-54290f124b30","headerVersion":1,"ordinal":0,"value":"PROPOSED"},{"description":"The instance is being developed.","descriptionGUID":"4c12b07e-456e-4d9f-896f-af658e2e56af","headerVersion":1,"ordinal":1,"value":"UNDER_DEVELOPMENT"},{"description":"The development of the instance is complete.","descriptionGUID":"5021b989-9366-45b0-b319-96c73e3f8327","headerVersion":1,"ordinal":2,"value":"DEVELOPMENT_COMPLETE"},{"description":"The instance is approved for deployment.","descriptionGUID":"e12fbb93-68e9-47dd-8358-0210333596f6","headerVersion":1,"ordinal":3,"value":"APPROVED_FOR_DEPLOYMENT"},{"description":"The request to deploy is not approved.","descriptionGUID":"fea9cadb-c6ad-4cd1-a7b8-8ec828763f06","headerVersion":1,"ordinal":4,"value":"REJECTED"},{"description":"The instance is deployed in standby mode.","descriptionGUID":"eb6c2178-fb0d-4cde-8765-5bf1ea9f2b04","headerVersion":1,"ordinal":5,"value":"STANDBY"},{"description":"The instance is approved and in use.","descriptionGUID":"1246d30b-bd49-47e6-a9ff-4dfc27b10cfb","headerVersion":1,"ordinal":6,"value":"ACTIVE"},{"description":"The instance is shutdown or disabled.","descriptionGUID":"ebf70b34-2cc8-47eb-9123-d5c212aa03a8","headerVersion":1,"ordinal":7,"value":"DISABLED"},{"description":"The instance is not in use due to failure.","descriptionGUID":"e16ea92f-0e58-4953-a073-d77c52287426","headerVersion":1,"ordinal":8,"value":"FAILED"},{"description":"The instance is in a locally defined state.","descriptionGUID":"655a377c-c665-4f89-bb85-c3aa3e60877e","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"77b057f0-8088-461f-bcc4-e557d58ec94b","headerVersion":1,"name":"DeploymentStatus","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"headerVersion":1,"ordinal":99},"description":"Defines the type of media.","descriptionGUID":"7d2d2830-d95b-4d9e-8f46-26f5eace592b","descriptionWiki":"https://egeria-project.org/types/0/0015-Linked-Media-Types/","elementDefs":[{"description":"The media is an image.","descriptionGUID":"9f7d9fff-1b66-4461-b9c1-32b84ab6f8b70","headerVersion":1,"ordinal":0,"value":"IMAGE"},{"description":"The media is an audio recording.","descriptionGUID":"53dad430-81c0-422e-a265-8ef49748ab1a","headerVersion":1,"ordinal":1,"value":"AUDIO"},{"description":"The media is a text document - probably rich text.","descriptionGUID":"9e1447cd-a053-4c55-9a99-b6771697fcfb","headerVersion":1,"ordinal":2,"value":"DOCUMENT"},{"description":"The media is a video recording.","descriptionGUID":"3e351708-b5ae-46c9-890e-83892cd96bb6","headerVersion":1,"ordinal":3,"value":"VIDEO"},{"description":"The media type is not supported.","descriptionGUID":"340ffbeb-3076-4038-ae07-417b685c4825","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"9548390c-69f5-4dc6-950d-6fdffb257b56","headerVersion":1,"name":"MediaType","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"headerVersion":1,"ordinal":99},"description":"Defines how a related media reference should be used.","descriptionGUID":"55f8bcb1-2cd5-4965-859c-62cd083985ce","descriptionWiki":"https://egeria-project.org/types/0/0015-Linked-Media-Types/","elementDefs":[{"description":"Provides a small image to represent the element in tree views and graphs.","descriptionGUID":"a54bdf05-b0e4-4b7d-a4c6-171eb5a1106f","headerVersion":1,"ordinal":0,"value":"ICON"},{"description":"Provides a small image about the element that can be used in lists.","descriptionGUID":"af0ba30c-dc67-4b12-863c-9a4bf955a197","headerVersion":1,"ordinal":1,"value":"THUMBNAIL"},{"description":"Illustrates how the element works or what it contains. It is complementary to the element's description.","descriptionGUID":"cc3cc0b9-dbd1-4e3e-a97b-8a57d77a09cf","headerVersion":1,"ordinal":2,"value":"ILLUSTRATION"},{"description":"Provides guidance to a person on how to use the associated element.","descriptionGUID":"7d51d180-52f4-46a5-b4f4-14fed97dcdb6","headerVersion":1,"ordinal":3,"value":"USAGE_GUIDANCE"},{"description":"Another usage.","descriptionGUID":"2eb7afc3-1c9f-42fb-8634-6ec06d6023af","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"c6861a72-7485-48c9-8040-876f6c342b61","headerVersion":1,"name":"MediaUsage","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"headerVersion":1,"ordinal":99},"description":"Defines the type of identifier used for a digital resource.","descriptionGUID":"c6812f55-cc75-4e60-af29-74b53f03ddb5","descriptionWiki":"https://egeria-project.org/types/0/0017-External-Identifiers/","elementDefs":[{"description":"Unique key allocated and used within the scope of a single system.","descriptionGUID":"b5bcf0a5-19a3-4755-ac52-518bd4783952","headerVersion":1,"ordinal":0,"value":"LOCAL_KEY"},{"description":"Key allocated and used within the scope of a single system that is periodically reused for different records.","descriptionGUID":"fe1e739e-4825-49a2-84af-aeb5096c6a75","headerVersion":1,"ordinal":1,"value":"RECYCLED_KEY"},{"description":"Key derived from an attribute of the entity, such as email address, passport number.","descriptionGUID":"8828af2a-dcaa-4024-8b14-3d4082779d5c","headerVersion":1,"ordinal":2,"value":"NATURAL_KEY"},{"description":"Key value copied from another system.","descriptionGUID":"840a9ccb-45d4-4569-b76b-b88c3a814d1a","headerVersion":1,"ordinal":3,"value":"MIRROR_KEY"},{"description":"Key formed by combining keys from multiple systems.","descriptionGUID":"d9a3e37f-6bd8-414b-a37c-f24b5af08d27","headerVersion":1,"ordinal":4,"value":"AGGREGATE_KEY"},{"description":"Key from another system can bey used if system name provided.","descriptionGUID":"292fd669-f3c9-436e-af61-2a4ad184dbb7","headerVersion":1,"ordinal":5,"value":"CALLERS_KEY"},{"description":"Key value will remain active even if records are merged.","descriptionGUID":"1820a91d-0d8a-4567-9fbd-d27d444f646a","headerVersion":1,"ordinal":6,"value":"STABLE_KEY"},{"description":"Another key pattern.","descriptionGUID":"d97a668e-bfc9-4ed6-a3a9-b133a4c2ef49","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"8904df8f-1aca-4de8-9abd-1ef2aadba300","headerVersion":1,"name":"KeyPattern","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"description":"Metadata exchange is permitted in both directions.  Synchronization is halted on a specific element if potentially clashing updates have occurred both in the third party technology and open metadata.  Such conflicts are logged on the audit log and resolved through manual stewardship.","descriptionGUID":"3ecbbab2-8c60-49be-97cd-be1d0bca49e9","headerVersion":1,"ordinal":0,"value":"BOTH_DIRECTIONS"},"description":"Defines the permitted direction of exchange of metadata with a third party technology.","descriptionGUID":"c6233ba5-1438-4391-90c5-569d1f54746e","descriptionWiki":"https://egeria-project.org/types/0/0017-External-Identifiers/","elementDefs":[{"description":"Metadata exchange is permitted in both directions.  Synchronization is halted on a specific element if potentially clashing updates have occurred both in the third party technology and open metadata.  Such conflicts are logged on the audit log and resolved through manual stewardship.","descriptionGUID":"3ecbbab2-8c60-49be-97cd-be1d0bca49e9","headerVersion":1,"ordinal":0,"value":"BOTH_DIRECTIONS"},{"description":"The third party technology is logically downstream of open metadata.  This means the open metadata ecosystem is the originator and owner of the metadata being synchronized. Any updates detected in the third technology are overridden by the latest open metadata values.","descriptionGUID":"7fe0046d-8b1a-4931-b9b7-18279c6f449a","headerVersion":1,"ordinal":1,"value":"TO_THIRD_PARTY"},{"description":"The third party technology is logically upstream (the originator and owner of the metadata).  Any updates made in open metadata are not passed to the third party technology and the third party technology is requested to refresh the open metadata version.","descriptionGUID":"9ed53b29-f843-4af2-b510-44683d84b2d0","headerVersion":1,"ordinal":2,"value":"FROM_THIRD_PARTY"},{"description":"Another type of synchronization rule - see description property.","descriptionGUID":"332853a9-af08-4210-a9dd-48e40db5ee09","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"973a9f4c-93fa-43a5-a0c5-d97dbd164e78","headerVersion":1,"name":"PermittedSynchronization","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"description":"Bits or bytes ordered from the little end.","descriptionGUID":"645a85ba-2c11-42f3-8e84-bf8520b97798","headerVersion":1,"ordinal":1,"value":"LITTLE_ENDIAN"},"description":"Defines the sequential order in which bytes are arranged into larger numerical values when stored in memory or when transmitted over digital links.","descriptionGUID":"81bc8b88-ee80-493f-9f32-66c65d2b1f46","descriptionWiki":"https://egeria-project.org/types/0/0030-Operating-Platforms/","elementDefs":[{"description":"Bits or bytes order from the big end.","descriptionGUID":"a803158c-f178-4867-b634-1c02755b7d4a","headerVersion":1,"ordinal":0,"value":"BIG_ENDIAN"},{"description":"Bits or bytes ordered from the little end.","descriptionGUID":"645a85ba-2c11-42f3-8e84-bf8520b97798","headerVersion":1,"ordinal":1,"value":"LITTLE_ENDIAN"}],"guid":"e5612c3a-49bd-4148-8f67-cfdf145d5fd8","headerVersion":1,"name":"ByteOrdering","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"description":"The software server capability is accountable for the maintenance and protection of the asset.","descriptionGUID":"2cd9be3f-aab1-45cb-86d8-b73e5e1287d5","headerVersion":1,"ordinal":0,"value":"OWNS"},"description":"Defines how a software server capability may use an asset.","descriptionGUID":"7d9d5d67-1915-4944-a985-f01cc5394da7","elementDefs":[{"description":"The software server capability is accountable for the maintenance and protection of the asset.","descriptionGUID":"2cd9be3f-aab1-45cb-86d8-b73e5e1287d5","headerVersion":1,"ordinal":0,"value":"OWNS"},{"description":"The software server capability provides management or oversight of the asset.","descriptionGUID":"264f123e-8675-4bc1-a4b4-1cfc96b95a08","headerVersion":1,"ordinal":1,"value":"GOVERNS"},{"description":"The software server capability keeps the asset up-to-date.","descriptionGUID":"e2bae930-4cef-431f-add3-44d3e1e32112","headerVersion":1,"ordinal":2,"value":"MAINTAINS"},{"description":"The server capability consumes the content of the asset.","descriptionGUID":"8a91ee82-f840-4eef-aa8f-b5eda277692a","headerVersion":1,"ordinal":3,"value":"USES"},{"description":"Other usage.","descriptionGUID":"e9cfe66e-6b54-46f7-8351-038088c0e83b","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"09439481-9489-467c-9ae5-178a6e0b6b5a","headerVersion":1,"name":"CapabilityAssetUseType","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"headerVersion":1,"ordinal":99},"description":"Type of mechanism to contact an actor.","descriptionGUID":"f1a4633e-2890-4952-bef2-1ba47d73f885","descriptionWiki":"https://egeria-project.org/types/1/0110-Actors/","elementDefs":[{"description":"Send email.","descriptionGUID":"9ae0f271-e59b-4212-a123-0cb2e431a4f5","headerVersion":1,"ordinal":0,"value":"EMAIL"},{"description":"Call by phone.","descriptionGUID":"23c948f2-a878-4827-ad9f-d189df16bf34","headerVersion":1,"ordinal":1,"value":"PHONE"},{"description":"Send chat message.","descriptionGUID":"472de896-f9b2-48a9-aed6-728e9006a662","headerVersion":1,"ordinal":2,"value":"CHAT"},{"description":"Send comment to personal profile.","descriptionGUID":"d6df84bb-96e7-40c6-926f-3728644912c7","headerVersion":1,"ordinal":3,"value":"PROFILE"},{"description":"Send comment to a social media account.","descriptionGUID":"dada5489-a1cb-433e-a233-6b481ee93edb","headerVersion":1,"ordinal":4,"value":"ACCOUNT"},{"description":"Another contact mechanism.","descriptionGUID":"b9e40635-5fa7-4c5d-89e2-ecd77ba4fbab","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"30e7d8cd-df01-46e8-9247-a24c5650910d","headerVersion":1,"name":"ContactMethodType","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"description":"The status of the member is not known or not specified. This is the default value.","descriptionGUID":"c278c32d-52c3-44b3-aa3c-5a755a454af9","headerVersion":1,"ordinal":0,"value":"UNKNOWN"},"description":"Defines the provenance and confidence that a member belongs in a collection.","descriptionGUID":"bd00ab69-de86-4461-8062-6aceabf8ef99","descriptionWiki":"https://egeria-project.org/types/0/0021-Collections/","elementDefs":[{"description":"The status of the member is not known or not specified. This is the default value.","descriptionGUID":"c278c32d-52c3-44b3-aa3c-5a755a454af9","headerVersion":1,"ordinal":0,"value":"UNKNOWN"},{"description":"The member was added by an automated process.","descriptionGUID":"eca11907-5088-4536-a9ca-d0d4e82b4040","headerVersion":1,"ordinal":1,"value":"DISCOVERED"},{"description":"The member was proposed by a consumer.","descriptionGUID":"24b1c123-21b9-4754-b95b-4641d02672b1","headerVersion":1,"ordinal":2,"value":"PROPOSED"},{"description":"The member was imported from another system.","descriptionGUID":"76410870-bf5c-4594-84ea-c4ce809f8ffd","headerVersion":1,"ordinal":3,"value":"IMPORTED"},{"description":"The member has been validated by a custodian/steward/approver and can be trusted.","descriptionGUID":"e6351cfb-d48d-413b-97db-89be80c2fcb2","headerVersion":1,"ordinal":4,"value":"VALIDATED"},{"description":"The membership has been deprecated. Consider stopping using it.","descriptionGUID":"9736b9fb-250e-48ed-9b9a-2ed6e0e76743","headerVersion":1,"ordinal":5,"value":"DEPRECATED"},{"description":"The membership is obsolete and should not be used.","descriptionGUID":"1e1a8f3a-2962-4b1d-8cf5-255a4569ea27","headerVersion":1,"ordinal":6,"value":"OBSOLETE"},{"description":"The membership has a different status not covered by the open metadata types.","descriptionGUID":"d1867eca-f908-4c79-b548-cb86482a8e2a","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"a3bdb2ac-c28e-4e5a-8ab7-76aa01038832","headerVersion":1,"name":"MembershipStatus","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"headerVersion":1,"ordinal":99},"description":"Level of support or appreciation for an item.","descriptionGUID":"6c22fabf-077f-40c0-8739-eedf7c516927","descriptionWiki":"https://egeria-project.org/types/1/0150-Feedback/","elementDefs":[{"description":"Not recommended","descriptionGUID":"cd72592e-cd29-4fb7-ae28-2da10542eb5e","headerVersion":1,"ordinal":0,"value":"NOT_RECOMMENDED"},{"description":"Poor","descriptionGUID":"10d17243-5000-49c0-84fe-f125c3a8557b","headerVersion":1,"ordinal":1,"value":"ONE_STAR"},{"description":"Usable","descriptionGUID":"88bb3fb6-e5a4-4b9d-9039-c9551ef374aa","headerVersion":1,"ordinal":2,"value":"TWO_STARS"},{"description":"Good","descriptionGUID":"f0f86c72-cc02-4202-9c31-e8e592d2e1cb","headerVersion":1,"ordinal":3,"value":"THREE_STARS"},{"description":"Very Good","descriptionGUID":"30694a0f-c142-4fac-8286-733cf92871fc","headerVersion":1,"ordinal":4,"value":"FOUR_STARS"},{"description":"Excellent","descriptionGUID":"4c1535c8-8e78-4dde-be9b-2a732f8609ee","headerVersion":1,"ordinal":5,"value":"FIVE_STARS"}],"guid":"77fea3ef-6ec1-4223-8408-38567e9d3c93","headerVersion":1,"name":"StarRating","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"description":"General comment about the element.","descriptionGUID":"4bbcf72c-4c88-482b-8331-07422542d5c0","headerVersion":1,"ordinal":0,"value":"STANDARD_COMMENT"},"description":"Defines the sequential order in which bytes are arranged into larger numerical values when stored in memory or when transmitted over digital links.","descriptionGUID":"5e8e769a-9c8b-4a84-9006-53c49d6efc72","descriptionWiki":"https://egeria-project.org/types/1/0150-Feedback/","elementDefs":[{"description":"General comment about the element.","descriptionGUID":"4bbcf72c-4c88-482b-8331-07422542d5c0","headerVersion":1,"ordinal":0,"value":"STANDARD_COMMENT"},{"description":"Asks a question to the people owning, managing or using the element.","descriptionGUID":"e0f0bb6d-ebc2-4d9d-8a76-95d26cd67b22","headerVersion":1,"ordinal":1,"value":"QUESTION"},{"description":"Answers a question (posted as a reply to the question).","descriptionGUID":"ed115faa-aefc-4328-a196-1e0336d3ff2b","headerVersion":1,"ordinal":2,"value":"ANSWER"},{"description":"Provides a suggestion on how to improve the element or its properties and description.","descriptionGUID":"ae22e098-29e3-46d5-a733-7c411276dc5d","headerVersion":1,"ordinal":3,"value":"SUGGESTION"},{"description":"Describes situations where this element has been used and related hints and tips.","descriptionGUID":"072f1357-f9fc-45a1-8c9d-27ee400ad2b2","headerVersion":1,"ordinal":4,"value":"USAGE_EXPERIENCE"},{"description":"Describes mandatory changes that must be made to the attached element(s).","descriptionGUID":"d1a1fc66-5a34-4f4b-99c3-91c4296e6c11","headerVersion":1,"ordinal":5,"value":"REQUIREMENT"},{"description":"Unknown comment type.","descriptionGUID":"dea55b37-ba37-4aff-a193-424a67b99111","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"06d5032e-192a-4f77-ade1-a4b97926e867","headerVersion":1,"name":"CommentType","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"headerVersion":1,"ordinal":99},"description":"Type of contributor to new information and/or assets.","descriptionGUID":"e15acff5-137b-4703-8b6b-6e984f68cddd","elementDefs":[{"description":"Unique key allocated and used within the scope of a single system.","descriptionGUID":"b5bcf0a5-19a3-4755-ac52-518bd4783952","headerVersion":1,"ordinal":0,"value":"LOCAL_KEY"},{"description":"Key allocated and used within the scope of a single system that is periodically reused for different records.","descriptionGUID":"fe1e739e-4825-49a2-84af-aeb5096c6a75","headerVersion":1,"ordinal":1,"value":"RECYCLED_KEY"},{"description":"Key derived from an attribute of the entity, such as email address, passport number.","descriptionGUID":"8828af2a-dcaa-4024-8b14-3d4082779d5c","headerVersion":1,"ordinal":2,"value":"NATURAL_KEY"},{"description":"Key value copied from another system.","descriptionGUID":"840a9ccb-45d4-4569-b76b-b88c3a814d1a","headerVersion":1,"ordinal":3,"value":"MIRROR_KEY"},{"description":"Key formed by combining keys from multiple systems.","descriptionGUID":"d9a3e37f-6bd8-414b-a37c-f24b5af08d27","headerVersion":1,"ordinal":4,"value":"AGGREGATE_KEY"},{"description":"Key from another system can bey used if system name provided.","descriptionGUID":"292fd669-f3c9-436e-af61-2a4ad184dbb7","headerVersion":1,"ordinal":5,"value":"CALLERS_KEY"},{"description":"Key value will remain active even if records are merged.","descriptionGUID":"1820a91d-0d8a-4567-9fbd-d27d444f646a","headerVersion":1,"ordinal":6,"value":"STABLE_KEY"},{"description":"Another key pattern.","descriptionGUID":"d97a668e-bfc9-4ed6-a3a9-b133a4c2ef49","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"0ded50c2-17cc-4ecf-915e-908e66dbb27f","headerVersion":1,"name":"CrowdSourcingRole","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"headerVersion":1,"ordinal":99},"description":"Descriptor for a port that indicates the direction that data is flowing.","descriptionGUID":"d5142643-0bc3-4a77-a1ec-1537db2fbe79","descriptionWiki":"https://egeria-project.org/types/2/0217-Ports/","elementDefs":[{"description":"Data is passed into the process.","descriptionGUID":"dbca8005-949d-4cc9-bc5f-f5aa66f09906","headerVersion":1,"ordinal":0,"value":"INPUT_PORT"},{"description":"Data is produced by the process.","descriptionGUID":"e6182593-ce3c-43ca-9163-5300b57b5017","headerVersion":1,"ordinal":1,"value":"OUTPUT_PORT"},{"description":"A request response interface is provided by the process.","descriptionGUID":"59fcdb6c-b57a-46db-bb79-256ed9af0a67","headerVersion":1,"ordinal":2,"value":"INOUT_PORT"},{"description":"A request response call is made by the process.","descriptionGUID":"4564ff30-68eb-46b6-8887-83d8575d19b6","headerVersion":1,"ordinal":3,"value":"OUTIN_PORT"},{"description":"None of the above.","descriptionGUID":"a3fa3fa4-8f25-408d-8093-f84619c2859e","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"b57Fbce7-42ac-71D1-D6a6-9f62Cb7C6dc3","headerVersion":1,"name":"PortType","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"headerVersion":1,"ordinal":99},"description":"Defines the confidence in the assigned relationship.","descriptionGUID":"67bba236-b1c8-4ee4-baf3-33ce99a18373","descriptionWiki":"https://egeria-project.org/types/3/0330-Terms/","elementDefs":[{"description":"The term relationship is in development.","descriptionGUID":"f9fc24e1-6e9c-4a18-a6b2-bf527e3b7666","headerVersion":1,"ordinal":0,"value":"DRAFT"},{"description":"The term relationship is approved and in use.","descriptionGUID":"de434072-dd43-4e9f-9859-edcd3c7e1dad","headerVersion":1,"ordinal":1,"value":"ACTIVE"},{"description":"The term relationship should no longer be used.","descriptionGUID":"cd7d701d-ecd5-461b-a741-df943c9db876","headerVersion":1,"ordinal":2,"value":"DEPRECATED"},{"description":"The term relationship must no longer be used.","descriptionGUID":"fbac0d79-e1c0-4e4f-8291-2e2b82aefa40","headerVersion":1,"ordinal":3,"value":"OBSOLETE"},{"description":"Another term relationship status.","descriptionGUID":"f4ff2b0b-fe6c-4969-9633-7405fe685158","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"42282652-7d60-435e-ad3e-7cfe5291bcc7","headerVersion":1,"name":"TermRelationshipStatus","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"headerVersion":1,"ordinal":99},"description":"Different types of activities.","descriptionGUID":"0b24f61f-5f13-4e8a-9b97-4fc3783b23e4","descriptionWiki":"https://egeria-project.org/types/3/0340-Dictionary/","elementDefs":[{"description":"A small, well defined processing operation.","descriptionGUID":"bbbc23c1-62b0-412a-a77e-6d41ada10c7c","headerVersion":1,"ordinal":0,"value":"OPERATION"},{"description":"A requested or required change.","descriptionGUID":"7785980d-3d52-438d-9ece-09e28be5d09a","headerVersion":1,"ordinal":1,"value":"ACTION"},{"description":"A piece of work for a person, organization or engine.","descriptionGUID":"c202f631-dc9c-4bd7-ab9d-f6eb6c7d53d0","headerVersion":1,"ordinal":2,"value":"TASK"},{"description":"A sequence of tasks.","descriptionGUID":"15039274-9069-4da1-a026-a15c7ba17b02","headerVersion":1,"ordinal":3,"value":"PROCESS"},{"description":"An organized activity to achieve a specific goal.","descriptionGUID":"21d0f37e-398d-4418-9eb4-49f2d6ce556f","headerVersion":1,"ordinal":4,"value":"PROJECT"},{"description":"Another type of activity.","descriptionGUID":"e207c15f-e30e-4585-a483-032f46eb6b16","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"af7e403d-9865-4ebb-8c1a-1fd57b4f4bca","headerVersion":1,"name":"ActivityType","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"headerVersion":1,"ordinal":99},"description":"Defines the provenance and confidence of a term assignment.","descriptionGUID":"ae0313dd-921d-4a1f-a71c-b234e1b2e543","descriptionWiki":"https://egeria-project.org/types/3/0370-Semantic-Assignment/","elementDefs":[{"description":"The term assignment was discovered by an automated process.","descriptionGUID":"6bfd3f33-e550-4575-a29f-7199f5865615","headerVersion":1,"ordinal":0,"value":"DISCOVERED"},{"description":"The term assignment was proposed by a subject-matter expert.","descriptionGUID":"2c939678-7381-44ba-beec-f30791e0b560","headerVersion":1,"ordinal":1,"value":"PROPOSED"},{"description":"The term assignment was imported from another metadata system.","descriptionGUID":"ac932f9e-a573-4c70-a49f-56830a5a535a","headerVersion":1,"ordinal":2,"value":"IMPORTED"},{"description":"The term assignment has been validated and approved by a subject-matter expert.","descriptionGUID":"18b3d426-e406-4098-ba6a-bb1e42318b21","headerVersion":1,"ordinal":3,"value":"VALIDATED"},{"description":"The term assignment should no longer be used.","descriptionGUID":"6234a509-6d96-4450-adaf-d97918ec8646","headerVersion":1,"ordinal":4,"value":"DEPRECATED"},{"description":"The term assignment must no longer be used.","descriptionGUID":"289ffbed-3fb7-4e6a-a4e1-8f11e83bd1ac","headerVersion":1,"ordinal":5,"value":"OBSOLETE"},{"description":"The term assignment is in a locally defined state.","descriptionGUID":"74cfc2eb-4669-4780-a9b7-ca49d3661630","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"c8fe36ac-369f-4799-af75-46b9c1343ab3","headerVersion":1,"name":"TermAssignmentStatus","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"description":"The instances of the schema attribute may appear in any order.","descriptionGUID":"8d7bcad1-f779-4563-8c32-d35b26b9eb1c","headerVersion":1,"ordinal":99,"value":"UNSORTED"},"description":"Defines the suggested order that data values in this data item should be sorted by.","descriptionGUID":"3ad77990-beda-4877-b5ae-5368c372cab6","descriptionWiki":"https://egeria-project.org/types/5/0505-Schema-Attributes/","elementDefs":[{"description":"The attribute instances are organized so that the smallest/lowest value is first and the rest of the instances follow in ascending order.","descriptionGUID":"f940039e-eced-411e-b013-daf683780fc8","headerVersion":1,"ordinal":0,"value":"ASCENDING"},{"description":"The attribute instances are organized so that the largest/highest value is first and the rest of the instances follow in descending order.","descriptionGUID":"371e7314-d772-4c1c-a289-0b45e98d7b16","headerVersion":1,"ordinal":1,"value":"DESCENDING"},{"description":"The instances of the schema attribute may appear in any order.","descriptionGUID":"8d7bcad1-f779-4563-8c32-d35b26b9eb1c","headerVersion":1,"ordinal":99,"value":"UNSORTED"}],"guid":"aaa4df8f-1aca-4de8-9abd-1ef2aadba300","headerVersion":1,"name":"DataItemSortOrder","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"description":"The attribute's coverage category is unknown - this is the default.","descriptionGUID":"c7d696a0-0172-43c8-832f-ed2ddb8179dd","headerVersion":1,"ordinal":0,"value":"UNKNOWN"},"description":"Used to describe how a collection of data values for an attribute cover the domain of the possible values to the linked attribute.","descriptionGUID":"e9dafc67-8f64-4df6-99bf-c869e40a8223","descriptionWiki":"https://egeria-project.org/types/5/0505-Schema-Attributes/","elementDefs":[{"description":"The attribute's coverage category is unknown - this is the default.","descriptionGUID":"c7d696a0-0172-43c8-832f-ed2ddb8179dd","headerVersion":1,"ordinal":0,"value":"UNKNOWN"},{"description":"The attribute uniquely identifies the concept bead.","descriptionGUID":"0c9f3cdf-46c5-4371-a91d-62e18be07a8a","headerVersion":1,"ordinal":1,"value":"UNIQUE_IDENTIFIER"},{"description":"The attribute is a good indicator of the identity of the concept bead but not guaranteed to be unique.","descriptionGUID":"6355fee3-e42c-4e8c-b07b-7869c2d0d0bf","headerVersion":1,"ordinal":2,"value":"IDENTIFIER"},{"description":"The attribute provides information that is typically required by all of the consumers of the concept bead.","descriptionGUID":"dd3bc662-d093-4950-aea9-c2366399e87b","headerVersion":1,"ordinal":3,"value":"CORE_DETAIL"},{"description":"The attribute contains supplementary information that is of interest to specific consumers of the concept bead.","descriptionGUID":"26c116d1-fe89-4743-bfd9-024753af9c56","headerVersion":1,"ordinal":4,"value":"EXTENDED_DETAIL"}],"guid":"2c0ac237-e02e-431a-89fd-3107d94d4007","headerVersion":1,"name":"CoverageCategory","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"headerVersion":1,"ordinal":99},"description":"Defines the provenance and confidence of an assignment of a data definition such as a data class or a data grain to an element.","descriptionGUID":"36d8a171-1b8d-4f7e-88f1-f89b9566f33a","descriptionWiki":"https://egeria-project.org/types/5/0540-Data-Value-Specifications/","elementDefs":[{"description":"The term assignment was discovered by an automated process.","descriptionGUID":"4074e762-ef65-4705-aa37-940b42bde97c","headerVersion":1,"ordinal":0,"value":"DISCOVERED"},{"description":"The term assignment was proposed by a subject-matter expert.","descriptionGUID":"cf3477d9-8373-4894-b7e1-63722faca3cb","headerVersion":1,"ordinal":1,"value":"PROPOSED"},{"description":"The term assignment was imported from another metadata system.","descriptionGUID":"2fae7977-e463-4f03-a9fe-a3765faf8f5e","headerVersion":1,"ordinal":2,"value":"IMPORTED"},{"description":"The term assignment has been validated and approved by a subject-matter expert.","descriptionGUID":"b9dc8d2c-342e-4596-aa66-34c133731017","headerVersion":1,"ordinal":3,"value":"VALIDATED"},{"description":"The term assignment should no longer be used.","descriptionGUID":"519ca599-6675-4675-b9ce-e71262714216","headerVersion":1,"ordinal":4,"value":"DEPRECATED"},{"description":"The term assignment must no longer be used.","descriptionGUID":"cc18444b-c202-4c13-80fd-4caea1d2549e","headerVersion":1,"ordinal":5,"value":"OBSOLETE"},{"description":"The term assignment is in a locally defined state.","descriptionGUID":"6e5493c7-cd87-4de6-9570-6c9471f56f1f","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"2611892f-0527-478f-8843-a3aa2b9abb47","headerVersion":1,"name":"DataValueAssignmentStatus","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"description":"The relationship links two concept beads together.","descriptionGUID":"a4c4b33e-4013-4353-9b30-5ae817d7d04d","headerVersion":1,"ordinal":0,"value":"NONE"},"description":"Describes the type of relationship end in a model or schema.","descriptionGUID":"50671892-e2be-43d6-bcee-d82ece6a8c19","elementDefs":[{"description":"The relationship links two concept beads together.","descriptionGUID":"a4c4b33e-4013-4353-9b30-5ae817d7d04d","headerVersion":1,"ordinal":0,"value":"NONE"},{"description":"The relationship links an independent concept bead to a collection of concept beads.","descriptionGUID":"270e50f3-730c-46c8-9fd4-0c87aea5a72d","headerVersion":1,"ordinal":1,"value":"AGGREGATION"},{"description":"The relationship links a concept bead the other concept beads that describe its parts.","descriptionGUID":"3bae54fa-8eae-4890-959c-c5d3cc01bda9","headerVersion":1,"ordinal":2,"value":"COMPOSITION"},{"description":"The relationship links an extension to a base concept bead.","descriptionGUID":"349fe0bc-9972-49f7-8f7f-91158dab6c99","headerVersion":1,"ordinal":3,"value":"EXTENSION"}],"guid":"a97d9167-7dd6-4dea-a8cf-c73c57a0f470","headerVersion":1,"name":"RelationshipDecoration","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"headerVersion":1,"ordinal":99},"description":"Defines the status of an annotation.","descriptionGUID":"a2671bf6-5eef-4432-a189-1e99d84507e1","descriptionWiki":"https://egeria-project.org/types/6/0612-Annotation-Reviews/","elementDefs":[{"description":"AnnotationProperties has been created but not reviewed","descriptionGUID":"4a4cd94d-e407-4218-9d5b-fbc1a68a2d37","headerVersion":1,"ordinal":0,"value":"NEW_ANNOTATION"},{"description":"AnnotationProperties has been reviewed by no decision has been made","descriptionGUID":"273cb963-2145-470a-9040-7634c8f30f0b","headerVersion":1,"ordinal":1,"value":"REVIEWED_ANNOTATION"},{"description":"AnnotationProperties has been approved","descriptionGUID":"c5447bdb-d1dc-4d6a-811b-b98845ca19da","headerVersion":1,"ordinal":2,"value":"APPROVED_ANNOTATION"},{"description":"AnnotationProperties has been approved and insight has been added to Asset's metadata","descriptionGUID":"f561ac14-d6ea-44d7-a432-8f0dd2e40123","headerVersion":1,"ordinal":3,"value":"ACTIONED_ANNOTATION"},{"description":"AnnotationProperties has been reviewed and declared invalid","descriptionGUID":"6b9bc674-24ce-466f-8647-a2a303813341","headerVersion":1,"ordinal":4,"value":"INVALID_ANNOTATION"},{"description":"AnnotationProperties is invalid and should be ignored","descriptionGUID":"90949088-ca0f-4bd9-9936-ee6b343f5e94","headerVersion":1,"ordinal":5,"value":"IGNORE_ANNOTATION"},{"description":"AnnotationProperties's status stored in additional properties","descriptionGUID":"e16ec89e-f2af-4b63-bbac-a286ffdba771","headerVersion":1,"ordinal":98,"value":"OTHER_STATUS"},{"description":"AnnotationProperties has not had a status assigned","descriptionGUID":"691a566f-27a7-4106-817a-9f04fad870ab","headerVersion":1,"ordinal":99,"value":"UNKNOWN_STATUS"}],"guid":"71187df6-ef66-4f88-bc03-cd3c7f925165","headerVersion":1,"name":"AnnotationStatus","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"headerVersion":1,"ordinal":99},"description":"The containment relationship between two processes: the parent and one of its children.","descriptionGUID":"bb3cd2b2-d3c9-449c-b2f7-39db7d217caf","descriptionWiki":"https://egeria-project.org/types/2/0215-Software-Components/","elementDefs":[{"description":"The parent process owns the child process in the relationship, such that if the parent is removed the child should also be removed. A child can have at most one such parent.","descriptionGUID":"b05e2d4b-91e3-479f-96cc-6bf32c27ab9f","headerVersion":1,"ordinal":0,"value":"OWNED"},{"description":"The child process is simply used by the parent. A child process can have many such relationships to parents.","descriptionGUID":"b63ef91c-e496-40e3-85d0-eca4899b9980","headerVersion":1,"ordinal":1,"value":"USED"},{"description":"None of the above.","descriptionGUID":"5afd9a09-3215-4ed2-b005-add5888de74e","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"1bb4b908-7983-4802-a2b5-91b095552ee9","headerVersion":1,"name":"ProcessContainmentType","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"description":"The business capability has not been classified.","descriptionGUID":"ba489093-0bd4-416a-9b24-ed1574b93789","headerVersion":1,"ordinal":0,"value":"UNCLASSIFIED"},"description":"Defines the type or category of a business capability.","descriptionGUID":"ad3fcd68-4371-421e-9c9c-e944b11ad288","descriptionWiki":"https://egeria-project.org/types/7/0715-Digital-Business/","elementDefs":[{"description":"The business capability has not been classified.","descriptionGUID":"ba489093-0bd4-416a-9b24-ed1574b93789","headerVersion":1,"ordinal":0,"value":"UNCLASSIFIED"},{"description":"A functional business capability.","descriptionGUID":"612a3ecc-218b-47fd-bd75-fa8b6cdae87c","headerVersion":1,"ordinal":1,"value":"BUSINESS_SERVICE"},{"description":"A collection of related business services.","descriptionGUID":"fd762806-e784-4990-916f-acba931e8807","headerVersion":1,"ordinal":2,"value":"BUSINESS_AREA"},{"description":"An overall area of activity in which a business operates.  A single organization may operate multiple business domains, such as retail, distribution, banking, ...","descriptionGUID":"cbae16ce-3941-4f1b-8170-403b5b46725e","headerVersion":1,"ordinal":3,"value":"BUSINESS_DOMAIN"},{"description":"Another business capability type.","descriptionGUID":"769813b7-4e0f-40b4-a0f7-a74165de0ed5","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"fb7c40cf-8d95-48ff-ba8b-e22bff6f5a91","headerVersion":1,"name":"BusinessCapabilityType","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"headerVersion":1,"ordinal":99},"description":"Descriptor for a solution port that indicates the direction that data is flowing.","descriptionGUID":"cad833b8-4619-49f1-a28a-e6a60f38ef4f","descriptionWiki":"https://egeria-project.org/types/7/0735-Solution-Ports-and-Wires/","elementDefs":[{"description":"The direction of flow is unknown.","descriptionGUID":"29454899-dd9b-4855-8846-f7f1bb05e5d3","headerVersion":1,"ordinal":0,"value":"UNKNOWN"},{"description":"Data is passed into the solution component.","descriptionGUID":"d0148bd8-5240-4262-9181-c2e343111d79","headerVersion":1,"ordinal":2,"value":"INPUT"},{"description":"Data is produced by the solution component.","descriptionGUID":"ba93f0c5-e502-4a19-a1dd-0fda01dbe54c","headerVersion":1,"ordinal":1,"value":"OUTPUT"},{"description":"A request response interface is provided by the solution component.","descriptionGUID":"c9db81ce-6c98-480f-bf49-c05a13a832ca","headerVersion":1,"ordinal":3,"value":"INOUT"},{"description":"A request response call is made by the solution component.","descriptionGUID":"9e1339d2-92a5-41a3-9aed-8b0bd66a4a75","headerVersion":1,"ordinal":4,"value":"OUTIN"},{"description":"None of the above.","descriptionGUID":"a6b3233b-b38f-47ad-82aa-f8eb1748b946","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"4879c96e-26c7-48af-ba92-8277632be733","headerVersion":1,"name":"SolutionPortDirection","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"description":"If the element has lineage relationships then archive; otherwise soft-delete.","descriptionGUID":"eff96544-c730-4abe-b71e-1524b5859183","headerVersion":1,"ordinal":2,"value":"LOOK_FOR_LINEAGE"},"description":"Defines the type of delete function to use.","descriptionGUID":"d26f371a-812b-42d8-b983-b7c9545ddd0d","descriptionWiki":"https://egeria-project.org/types/4/0464-Dynamic-Integration-Groups/","elementDefs":[{"description":"Archive the element using the Memento classification so it is still available for lineage queries.","descriptionGUID":"733a7c13-0830-4a81-bedc-f317f81e2673","headerVersion":1,"ordinal":0,"value":"ARCHIVE"},{"description":"Delete the element from the active store, however it can still be restored if it has been deleted in error.","descriptionGUID":"db2e5c74-bc09-47de-8a80-22d9206de677","headerVersion":1,"ordinal":1,"value":"SOFT_DELETE"},{"description":"If the element has lineage relationships then archive; otherwise soft-delete.","descriptionGUID":"eff96544-c730-4abe-b71e-1524b5859183","headerVersion":1,"ordinal":2,"value":"LOOK_FOR_LINEAGE"},{"description":"Remove the element from the repository; this can not be restored automatically.  If you need it back, you need to look in the repository backups.","descriptionGUID":"51f6c127-a143-4adb-a14a-d6fb2e93109e","headerVersion":1,"ordinal":3,"value":"PURGE"},{"description":"Another type of delete.","descriptionGUID":"332853a9-af08-4210-a9dd-48e40db5ee09","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"6d1facbf-fd37-457f-8282-4dd824a9658d","headerVersion":1,"name":"DeleteMethod","version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"description":"There is no assessment of the criticality for this data.","descriptionGUID":"4c2c0370-973f-479c-9251-d400d55ad7e8","headerVersion":1,"ordinal":0,"value":"UNCLASSIFIED"},"description":"Defines the status of an incident report.","descriptionGUID":"f04543aa-3623-4ad6-af4a-cca56e6eaae5","descriptionWiki":"https://egeria-project.org/types/4/0470-Incident-Reporting/","elementDefs":[{"description":"There is no assessment of the criticality for this data.","descriptionGUID":"4c2c0370-973f-479c-9251-d400d55ad7e8","headerVersion":1,"ordinal":0,"value":"UNCLASSIFIED"},{"description":"The data is of minor importance to the organization.","descriptionGUID":"75cf926a-57f9-494d-8b08-995bd0dd7a72","headerVersion":1,"ordinal":1,"value":"MARGINAL"},{"description":"The data is important to the running of the organization.","descriptionGUID":"e78e4e87-9fa1-4b81-be4e-ca6b499d9898","headerVersion":1,"ordinal":2,"value":"IMPORTANT"},{"description":"The data is critical to the operation of the organization.","descriptionGUID":"a0b6807e-6440-48a7-b76c-847f9e95767a","headerVersion":1,"ordinal":3,"value":"CRITICAL"},{"description":"The data is so important that its loss is catastrophic, putting the future of the organization in doubt.","descriptionGUID":"e6effba2-3861-47f3-9738-dbc452532892","headerVersion":1,"ordinal":4,"value":"CATASTROPHIC"},{"description":"Another criticality level.","descriptionGUID":"81044dc1-ae06-404b-83d7-1c4180daa09e","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"a9d4f64b-fa24-4eb8-8bf6-308926ef2c14","headerVersion":1,"name":"IncidentReportStatus","version":1,"versionName":"6.2-SNAPSHOT"}],"newTypeDefs":[{"class":"EntityDef","category":"ENTITY_DEF","createTime":1577886131090,"createdBy":"ODPi Egeria","description":"Common root for all open metadata entity types.","descriptionGUID":"9f665566-2144-4c6c-95db-b1d1f86c412f","descriptionWiki":"https://egeria-project.org/types/0/0010-Base-Model/","guid":"4e7761e8-3969-4627-8f40-bfe3cde85a1d","headerVersion":1,"initialStatus":"ACTIVE","name":"OpenMetadataRoot","origin":"bce3b0a0-662a-4f87-b8dc-844078a11a6e","status":"ACTIVE_TYPEDEF","validInstanceStatusList":["ACTIVE","DELETED"],"version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EntityDef","category":"ENTITY_DEF","createTime":1577886131090,"createdBy":"ODPi Egeria","description":"An open metadata entity that has a unique identifier.","descriptionGUID":"d9a26761-40ba-441d-9981-cc8f137fe379","descriptionWiki":"https://egeria-project.org/types/0/0010-Base-Model/","guid":"a32316b8-dc8c-48c5-b12b-71c1b2a080bf","headerVersion":1,"initialStatus":"ACTIVE","name":"Referenceable","origin":"bce3b0a0-662a-4f87-b8dc-844078a11a6e","propertiesDefinition":[{"attributeCardinality":"ONE_ONLY","attributeDescription":"Unique name for the element.","attributeDescriptionGUID":"e31e5b9b-0f96-42a9-8e67-0e3fc66ad305","attributeName":"qualifiedName","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","headerVersion":1,"name":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":true,"valuesMaxCount":1,"valuesMinCount":1},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Identifier used in an external system.","attributeDescriptionGUID":"2f831c53-0c71-4e03-92ed-20a899ed771f","attributeName":"identifier","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","headerVersion":1,"name":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Display name of the element used for summary tables and titles.","attributeDescriptionGUID":"a42ceece-6cd8-4c71-9920-e3c96df3c8bb","attributeName":"displayName","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","