ng/","endDef1":{"attributeCardinality":"ANY_NUMBER","attributeDescription":"The annotations that refer to this log file.","attributeName":"resourceProfileAnnotations","entityType":{"guid":"368e6fb3-7323-4f81-a723-5182491594bd","headerVersion":1,"name":"ResourceProfileLogAnnotation","status":"ACTIVE_TYPEDEF"},"headerVersion":1},"endDef2":{"attributeCardinality":"ANY_NUMBER","attributeDescription":"Location of the profile information.","attributeName":"resourceProfileData","entityType":{"guid":"896d14c2-7522-4f6c-8519-757711943fe6","headerVersion":1,"name":"Asset","status":"ACTIVE_TYPEDEF"},"headerVersion":1},"guid":"2ebf2c09-b272-42a1-8fc0-e3eb44df296d","headerVersion":1,"initialStatus":"ACTIVE","multiLink":false,"name":"ResourceProfileData","origin":"bce3b0a0-662a-4f87-b8dc-844078a11a6e","propagationRule":"NONE","status":"ACTIVE_TYPEDEF","validInstanceStatusList":["ACTIVE","DELETED"],"version":1,"versionName":"6.2-SNAPSHOT"},{"class":"RelationshipDef","category":"RELATIONSHIP_DEF","createTime":1516313040008,"createdBy":"ODPi Egeria","description":"A hierarchical relationship between processes.","descriptionGUID":"bc7ee6c0-8130-42c4-a27f-476ebea2c108","descriptionWiki":"https://egeria-project.org/types/2/0215-Software-Components/","endDef1":{"attributeCardinality":"ANY_NUMBER","attributeDescription":"The more abstract or higher-level process.","attributeName":"parentProcesses","entityType":{"guid":"d8f33bd7-afa9-4a11-a8c7-07dcec83c050","headerVersion":1,"name":"Process","status":"ACTIVE_TYPEDEF"},"headerVersion":1},"endDef2":{"attributeCardinality":"ANY_NUMBER","attributeDescription":"The more detailed or lower-level process.","attributeName":"childProcesses","entityType":{"guid":"d8f33bd7-afa9-4a11-a8c7-07dcec83c050","headerVersion":1,"name":"Process","status":"ACTIVE_TYPEDEF"},"headerVersion":1},"guid":"70dbbda3-903f-49f7-9782-32b503c43e0e","headerVersion":1,"initialStatus":"ACTIVE","multiLink":false,"name":"ProcessHierarchy","origin":"bce3b0a0-662a-4f87-b8dc-844078a11a6e","propagationRule":"NONE","propertiesDefinition":[{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"The containment relationship between two processes: the parent and one of its children.","attributeDescriptionGUID":"563319e1-d17a-4b7b-ac78-393e5986bd38","attributeName":"containmentType","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"headerVersion":1,"ordinal":99},"description":"The containment relationship between two processes: the parent and one of its children.","descriptionGUID":"bb3cd2b2-d3c9-449c-b2f7-39db7d217caf","descriptionWiki":"https://egeria-project.org/types/2/0215-Software-Components/","elementDefs":[{"description":"The parent process owns the child process in the relationship, such that if the parent is removed the child should also be removed. A child can have at most one such parent.","descriptionGUID":"b05e2d4b-91e3-479f-96cc-6bf32c27ab9f","headerVersion":1,"ordinal":0,"value":"OWNED"},{"description":"The child process is simply used by the parent. A child process can have many such relationships to parents.","descriptionGUID":"b63ef91c-e496-40e3-85d0-eca4899b9980","headerVersion":1,"ordinal":1,"value":"USED"},{"description":"None of the above.","descriptionGUID":"5afd9a09-3215-4ed2-b005-add5888de74e","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"1bb4b908-7983-4802-a2b5-91b095552ee9","headerVersion":1,"name":"ProcessContainmentType","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0}],"status":"ACTIVE_TYPEDEF","validInstanceStatusList":["ACTIVE","DELETED"],"version":1,"versionName":"6.2-SNAPSHOT"},{"class":"RelationshipDef","category":"RELATIONSHIP_DEF","createTime":1516313040008,"createdBy":"ODPi Egeria","description":"Creates a controlling hierarchy for subject areas.","descriptionGUID":"b5fd6a99-8a4f-44cb-87e9-359b14b75e4b","descriptionWiki":"https://egeria-project.org/typ