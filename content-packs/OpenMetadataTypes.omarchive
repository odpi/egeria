derVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Primary address where this external source can be accessed from.","attributeDescriptionGUID":"604dbf10-335d-4132-8a32-c30fa9fec154","attributeName":"url","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","headerVersion":1,"name":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Additional properties for the element.","attributeDescriptionGUID":"534b5665-73d4-4bdc-b83b-1a8fed19dba3","attributeName":"additionalProperties","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"CollectionDef","argumentCount":2,"argumentTypes":["OM_PRIMITIVE_TYPE_STRING","OM_PRIMITIVE_TYPE_STRING"],"category":"COLLECTION","collectionDefCategory":"OM_COLLECTION_MAP","description":"A map from string to string.","descriptionGUID":"f285d0ca-50ab-4564-b129-c7e3ba4e8545","guid":"005c7c14-ac84-4136-beed-959401b041f8","headerVersion":1,"name":"map<string,string>","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0}],"status":"ACTIVE_TYPEDEF","superType":{"guid":"4e7761e8-3969-4627-8f40-bfe3cde85a1d","headerVersion":1,"name":"OpenMetadataRoot","status":"ACTIVE_TYPEDEF"},"validInstanceStatusList":["ACTIVE","DELETED"],"version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EntityDef","category":"ENTITY_DEF","createTime":1577886131090,"createdBy":"ODPi Egeria","description":"An open metadata entity that has lifecycle states to support an authoring workflow.","descriptionGUID":"97ed3470-dfaa-449c-b205-c22e203512b6","descriptionWiki":"https://egeria-project.org/types/0/0010-Base-Model/","guid":"136c2bef-29bd-4f1d-b320-7ef679bbb99d","headerVersion":1,"initialStatus":"ACTIVE","name":"AuthoredReferenceable","origin":"bce3b0a0-662a-4f87-b8dc-844078a11a6e","propertiesDefinition":[{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Defines the current status of an authored referenceable.","attributeDescriptionGUID":"c8e1b691-889d-467c-b551-df080cecf34f","attributeName":"contentStatus","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"headerVersion":1,"ordinal":99},"description":"Defines the current status of an authored referenceable.","descriptionGUID":"034dbb1b-9f95-4c57-8d83-28bb435e6584","descriptionWiki":"https://egeria-project.org/types/0/0010-Base-Model/","elementDefs":[{"description":"The content is incomplete.","descriptionGUID":"44084c0e-f893-4a6b-b364-c48f50338702","headerVersion":1,"ordinal":0,"value":"DRAFT"},{"description":"The content is ready for review.","descriptionGUID":"bc8fe5f2-d605-4c05-9054-d37ac9fe2811","headerVersion":1,"ordinal":1,"value":"PREPARED"},{"description":"The content is in review.","descriptionGUID":"f376157b-a596-4b83-946b-d7c0e4aadefd","headerVersion":1,"ordinal":2,"value":"PROPOSED"},{"description":"The content is approved.","descriptionGUID":"48c5d720-1001-421a-ba13-634c946bc605","headerVersion":1,"ordinal":3,"value":"APPROVED"},{"description":"The request or proposal is rejected.","descriptionGUID":"cf9ce6fb-d90a-4cb1-8c05-82fed71640e8","headerVersion":1,"ordinal":4,"value":"REJECTED"},{"description":"The instance is approved and in use.","descriptionGUID":"9be9aaee-f394-4342-83ed-ba29cc107398","headerVersion":1,"ordinal":5,"value":"ACTIVE"},{"description":"The instance is out of date and should not be used.","descriptionGUID":"c831d2a8-0b08-45ae-930d-e19038e7e1b1","headerVersion":1,"ordinal":6,"value":"DEPRECATED"},{"description":"The instance is no longer active and must not be used.","descriptionGUID":"a833d2a8-0b08-45ae-930d-e10038e8e1b1","headerVersion":1,"ordinal":7,"value":"OBSOLETE"},{"description":"The instance is in a locally defined state.","descriptionGUID":"2fd04d45-d6f2-4008-a679-42f7326f9b01","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"49f2808c-b5c8-48a9-8a36-672f9ea9a45f","headerVersion":1,"name":"ContentStatus","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Extend or replace the valid content statuses with additional statuses controlled through valid metadata values.","attributeDescriptionGUID":"099902e7-2c43-4b5d-b9f8-e921ebe22452","attributeName":"userDefinedContentStatus","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","headerVersion":1,"name":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"List of authors for the external source.","attributeDescriptionGUID":"b0dd1911-7bb6-47be-bd88-5a9c86f00fe0","attributeName":"authors","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"CollectionDef","argumentCount":1,"argumentTypes":["OM_PRIMITIVE_TYPE_STRING"],"category":"COLLECTION","collectionDefCategory":"OM_COLLECTION_ARRAY","description":"An array of strings.","descriptionGUID":"4a384611-d8c1-4909-a6f8-1385ffe210e2","guid":"0428b5d3-f824-459c-b7f5-f8151de59707","headerVersion":1,"name":"array<string>","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0}],"status":"ACTIVE_TYPEDEF","superType":{"guid":"a32316b8-dc8c-48c5-b12b-71c1b2a080bf","headerVersion":1,"name":"Referenceable","status":"ACTIVE_TYPEDEF"},"validInstanceStatusList":["ACTIVE","DELETED