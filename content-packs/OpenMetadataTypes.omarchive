configurationProperties","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"CollectionDef","argumentCount":2,"argumentTypes":["OM_PRIMITIVE_TYPE_STRING","OM_PRIMITIVE_TYPE_UNKNOWN"],"category":"COLLECTION","collectionDefCategory":"OM_COLLECTION_MAP","description":"A map from string to object.","descriptionGUID":"6dd2944b-9107-41c6-a10b-6a938fd6f2f5","guid":"8fa603dd-c2c5-43fc-8ff4-92141f2414ad","headerVersion":1,"name":"map<string,object>","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Map of template name to qualified name of parent element in associated catalog template.","attributeDescriptionGUID":"b87eccc4-764b-40c3-aa4b-69d8c9aaed71","attributeName":"templates","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"CollectionDef","argumentCount":2,"argumentTypes":["OM_PRIMITIVE_TYPE_STRING","OM_PRIMITIVE_TYPE_STRING"],"category":"COLLECTION","collectionDefCategory":"OM_COLLECTION_MAP","description":"A map from string to string.","descriptionGUID":"f285d0ca-50ab-4564-b129-c7e3ba4e8545","guid":"005c7c14-ac84-4136-beed-959401b041f8","headerVersion":1,"name":"map<string,string>","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Qualified name of a software server capability that is the owner of the metadata catalogued by the integration connector.","attributeDescriptionGUID":"5538fcb0-b3d9-4870-8d1f-1d2752c75255","attributeName":"metadataSourceQualifiedName","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","headerVersion":1,"name":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Qualified name of a metadata collection asset that is the home of the metadata catalogued by the integration connector.","attributeDescriptionGUID":"4dffd93d-c7f5-4772-b2c4-9b0594666a99","attributeName":"metadataCollectionQualifiedName","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","headerVersion":1,"name":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Defines the permitted directions of flow of metadata updates between open metadata and a third party technology.","attributeDescriptionGUID":"a1c8581e-ed5d-457d-a069-f847f28597d6","attributeName":"permittedSynchronization","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"description":"Metadata exchange is permitted in both directions.  Synchronization is halted on a specific element if potentially clashing updates have occurred both in the third party technology and open metadata.  Such conflicts are logged on the audit log and resolved through manual stewardship.","descriptionGUID":"3ecbbab2-8c60-49be-97cd-be1d0bca49e9","headerVersion":1,"ordinal":0,"value":"BOTH_DIRECTIONS"},"description":"Defines the permitted direction of exchange of metadata with a third party technology.","descriptionGUID":"c6233ba5-1438-4391-90c5-569d1f54746e","descriptionWiki":"https://egeria-project.org/types/0/0017-External-Identifiers/","elementDefs":[{"description":"Metadata exchange is permitted in both directions.  Synchronization is halted on a specific element if potentially clashing updates have occurred both in the third party technology and open metadata.  Such conflicts are logged on the audit log and resolved through manual stewardship.","descriptionGUID":"3ecbbab2-8c60-49be-97cd-be1d0bca49e9","headerVersion":1,"ordinal":0,"value":"BOTH_DIRECTIONS"},{"description":"The third party technology is logically downstream of open metadata.  This means the open metadata ecosystem is the originator and owner of the metadata being synchronized. Any updates detected in the third technology are overridden by the latest open metadata values.","descriptionGUID":"7fe0046d-8b1a-4931-b9b7-18279c6f449a","headerVersion":1,"ordinal":1,"value":"TO_THIRD_PARTY"},{"description":"The third party technology is logically upstream (the originator and owner of the metadata).  Any updates made in open metadata are not passed to the third party technology and the third party technology is requested to refresh the open metadata version.","descriptionGUID":"9ed53b29-f843-4af2-b510-44683d84b2d0","headerVersion":1,"ordinal":2,"value":"FROM_THIRD_PARTY"},{"description":"Another type of synchronization rule - see description property.","descriptionGUID":"332853a9-af08-4210-a9dd-48e40db5ee09","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"973a9f4c-93fa-43a5-a0c5-d97dbd164e78","headerVersion":1,"name":"PermittedSynchronization","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Identifies which type of delete to use.","attributeDescriptionGUID":"0028d073-fe1f-482d-b546-28a77dd712e2","attributeName":"deleteMethod","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"EnumDef","category":"ENUM_DEF","defaultValue":{"description":"If the element has lineage relationships then archive; otherwise soft-delete.","descriptionGUID":"eff96544-c730-4abe-b71e-1524b5859183","headerVersion":1,"ordinal":2,"value":"LOOK_FOR_LINEAGE"},"description":"Defines the type of delete function to use.","descriptionGUID":"d26f371a-812b-42d8-b983-b7c9545ddd0d","descriptionWiki":"https://egeria-project.org/types/4/0464-Dynamic-Integration-Groups/","elementDefs":[{"description":"Archive the element using the Memento classification so it is still available for lineage queries.","descriptionGUID":"733a7c13-0830-4a81-bedc-f317f81e2673","headerVersion":1,"ordinal":0,"value":"ARCHIVE"},{"description":"Delete the element from the active store, however it can still be restored if it has been deleted in error.","descriptionGUID":"db2e5c74-bc09-47de-8a80-22d9206de677","headerVersion":1,"ordinal":1,"value":"SOFT_DELETE"},{"description":"If the element has lineage relationships then archive; otherwise soft-delete.","descriptionGUID":"eff96544-c730-4abe-b71e-1524b5859183","headerVersion":1,"ordinal":2,"value":"LOOK_FOR_LINEAGE"},{"description":"Remove the element from the repository; this can not be restored automatically.  If you need it back, you need to look in the repository backups.","descriptionGUID":"51f6c127-a143-4adb-a14a-d6fb2e93109e","headerVersion":1,"ordinal":3,"value":"PURGE"},{"description":"Another type of delete.","descriptionGUID":"332853a9-af08-4210-a9dd-48e40db5ee09","headerVersion":1,"ordinal":99,"value":"OTHER"}],"guid":"6d1facbf-fd37-457f-8282-4dd824a9658d","headerVersion":1,"name":"DeleteMethod","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0}],"status":"ACTIVE_TYPEDEF","validInstanceStatusList":["ACTIVE","DELETED"],"version":1,"versionName":"6.2-SNAPSHOT"},{"class":"RelationshipDef","category":"RELATIONSHIP_DEF","createTime":1588261366992,"createdBy":"Egeria","description":"Relationship identifying the flow between segments in an information supply chain.","descriptionGUID":"cbac3fcc-b685-4e99-abb3-d1a14061ffee","descriptionWiki":"https://egeria-project.org/types/7/0720-Information-Supply-Chains/","endDef1":{"attributeCardinality":"ANY_NUMBER","attributeDescription":"Logical source of the informat