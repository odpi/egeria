starred the repository during its lifetime.","attributeDescriptionGUID":"141f7136-fa64-4c4c-8433-85797e628345","attributeName":"stargazerCount","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"33a91510-92ee-4825-9f49-facd7a6f9db6","headerVersion":1,"name":"long","primitiveDefCategory":"OM_PRIMITIVE_TYPE_LONG","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0}],"status":"ACTIVE_TYPEDEF","superType":{"guid":"6cea5b53-558c-48f1-8191-11d48db29fb4","headerVersion":1,"name":"Annotation","status":"ACTIVE_TYPEDEF"},"validInstanceStatusList":["ACTIVE","DELETED"],"version":1,"versionName":"6.2-SNAPSHOT"},{"class":"EntityDef","category":"ENTITY_DEF","createTime":1769277597779,"createdBy":"Egeria","description":"A set of properties describing the content of the code in a code repository like GitHub.","descriptionGUID":"cfd02960-9d5e-4d57-938a-8a7a393698da","descriptionWiki":"https://egeria-project.org/types/6/0680-Code-Analysis/","guid":"cc4bcbc1-e3c6-4dec-b91f-6cd8a3111af8","headerVersion":1,"initialStatus":"ACTIVE","name":"CodeAnalysisAnnotation","origin":"bce3b0a0-662a-4f87-b8dc-844078a11a6e","propertiesDefinition":[{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Number of files in the source code repository.","attributeDescriptionGUID":"a82b6835-9aed-4096-bd79-676e3b6f2c83","attributeName":"fileCount","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"33a91510-92ee-4825-9f49-facd7a6f9db6","headerVersion":1,"name":"long","primitiveDefCategory":"OM_PRIMITIVE_TYPE_LONG","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Total number of physical lines in the source code repository, including blank lines and comments.","attributeDescriptionGUID":"acde4557-9b78-4aa4-a315-08ea0ad04910","attributeName":"lineCount","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"33a91510-92ee-4825-9f49-facd7a6f9db6","headerVersion":1,"name":"long","primitiveDefCategory":"OM_PRIMITIVE_TYPE_LONG","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Number of lines of code in the source code repository, excluding blank lines and comments.","attributeDescriptionGUID":"cf4919e3-4e9c-45d8-9e71-245ea405d3e7","attributeName":"codeLineCount","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"33a91510-92ee-4825-9f49-facd7a6f9db6","headerVersion":1,"name":"long","primitiveDefCategory":"OM_PRIMITIVE_TYPE_LONG","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Number of comment lines in the source code repository.  This is measured directly rather than derived from the other line counts so that it is still available when one of them is missing.","attributeDescriptionGUID":"5329c4ca-4233-4768-a12d-7f185e574471","attributeName":"commentLineCount","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"33a91510-92ee-4825-9f49-facd7a6f9db6","headerVersion":1,"name":"long","primitiveDefCategory":"OM_PRIMITIVE_TYPE_LONG","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"The programming language that most of the source code in the repository is written in.","attributeDescriptionGUID":"04565a6e-4053-458d-a38b-df4b6fb0f981","attributeName":"primaryLanguage","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","headerVersion":1,"name":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Number of distinct programming languages used in the source code repository.  Polyglot components carry a higher maintenance cost.","attributeDescriptionGUID":"d8d12e02-e8b7-4cad-b57d-15a3e22df5e8","attributeName":"languageCount","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"33a91510-92ee-4825-9f49-facd7a6f9db6","headerVersion":1,"name":"long","primitiveDefCategory":"OM_PRIMITIVE_TYPE_LONG","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Number of symbols that the component exports for use by its callers, such as public functions, classes and endpoints.","attributeDescriptionGUID":"ee87eba9-4d86-4522-9823-c4b774c34aab","attributeName":"publicSymbolCount","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"33a91510-92ee-4825-9f49-facd7a6f9db6","headerVersion":1,"name":"long","primitiveDefCategory":"OM_PRIMITIVE_TYPE_LONG","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Number of entry points into the component, such as main methods, command line commands, route handlers and task definitions.","attributeDescriptionGUID":"a76e3408-2309-42de-b493-a71db56221a0","attributeName":"entryPointCount","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"33a91510-92ee-4825-9f49-facd7a6f9db6","headerVersion":1,"name":"long","primitiveDefCategory":"OM_PRIMITIVE_TYPE_LONG","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Number of places in the code where data is read.","attributeDescriptionGUID":"155c444a-0a5d-4f81-834b-4a90beaa928f","attributeName":"dataReadCount","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"33a91510-92ee-4825-9f49-facd7a6f9db6","headerVersion":1,"name":"long","primitiveDefCategory":"OM_PRIMITIVE_TYPE_LONG","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Number of places in the code where data is created.","attributeDescriptionGUID":"f695782b-0a82-487c-9c4e-3a94d0c5d1b1","attributeName":"dataCreateCount","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"33a91510-92ee-4825-9f49-facd7a6f9db6","headerVersion":1,"name":"long","primitiveDefCategory":"OM_PRIMITIVE_TYPE_LONG","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMinCount":0},{"attributeCardinality":"AT_MOST_ONE","attributeDescription":"Number of places in the code where data is updated.","attributeDescriptionGUID":"7ce649b3-230e-45f2-ace8-f126f99606ab","attributeName":"dataUpdateCount","attributeStatus":"ACTIVE_ATTRIBUTE","attributeType":{"class":"PrimitiveDef","category":"PRIMITIVE","guid":"33a91510-92ee-4825-9f49-facd7a6f9db6","headerVersion":1,"name":"long","primitiveDefCategory":"OM_PRIMITIVE_TYPE_LONG","version":1,"versionName":"6.2-SNAPSHOT"},"headerVersion":1,"indexable":true,"unique":false,"valuesMaxCount":1,"valuesMi