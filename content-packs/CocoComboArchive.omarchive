","typeName":"string"},"anchorScopeGUIDs":{"class":"ArrayPropertyValue","arrayCount":1,"arrayValues":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"0":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"2f48981a-d752-4b96-b67f-d0206b2a7681","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"headerVersion":1,"instancePropertyCategory":"ARRAY","typeGUID":"0428b5d3-f824-459c-b7f5-f8151de59707","typeName":"array<string>"},"anchorTypeName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"GlossaryTerm","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"CLASSIFICATION_DEF","typeDefGUID":"aa44f302-2e43-4669-a1e7-edaae414fc6e","typeDefName":"Anchors","typeDefVersion":1},"updateTime":1639984840038,"updatedBy":"Egeria Project","version":1791274688680}],"createTime":1639984840038,"createdBy":"Egeria Project","guid":"0fc2a5a4-85f3-4d65-9cb7-0794111c47c6","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"655b1965-4c29-4a0e-8a5d-3f55a37b3799","metadataCollectionName":"Coco Pharmaceuticals Combination","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"description":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Production emissions are emissions attributable to emissions produced domestically and include domestic consumption and exports. This definition follows the territorial emissions approach adopted by UNFCCC for annual national inventories and is typically referenced by sovereigns in their Nationally Determined Contributions (NDCs). \nIn line with UNFCCC, the emissions should cover GHG emissions from specified key sectors and categories (energy, industrial processes and product use, agriculture, forestry, other land use, and waste).10 However, there is a divergence of views among emissions data providers and climate experts regarding the accounting of land use, land-use change, and forestry (LULUCF) emissions given significant data uncertainty. Also, LULUCF emissions have the potential to distort the overall trends of the key sectors (energy, industrial processes) that contribute to global warming. \nBecause LULUCF emissions are typically included in countries’ mitigation targets in their NDCs, PCAF recommends using the complete emissions data (including LULUCF) for reporting for accounting purposes. FIs might also consider tracking and reviewing the data excluding LULUCF for a deeper assessment of sovereign GHG reduction progress. \nAlthough Production Emissions is currently the key metric to account for sovereign GHG emissions, PCAF also recommends that FIs track the GHG emissions of countries more holistically and use Consumption Emissions as an optional supporting metric (e.g., Absolute Emissions Levels, Emission Intensity). ","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"displayName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Production Emissions","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"qualifiedName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"GlossaryTerm::Production Emissions","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"summary":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Emissions attributable to emissions produced domestically and include domestic consumption and exports","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"versionIdentifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"6.3-SNAPSHOT","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"ENTITY_DEF","typeDefGUID":"0db3e6ec-f5ef-4d75-ae38-b7ee6fd6ec0a","typeDefName":"GlossaryTerm","typeDefVersion":1},"updateTime":1639984840038,"updatedBy":"Egeria Project","version":1791274688680},{"class":"EntityDetail","classifications":[{"class":"Classification","classificationOrigin":"ASSIGNED","createTime":1639984840038,"createdBy":"Egeria Project","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"655b1965-4c29-4a0e-8a5d-3f55a37b3799","metadataCollectionName":"Coco Pharmaceuticals Combination","name":"Anchors","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"anchorDomainName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"AuthoredReferenceable","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"anchorScopeGUIDs":{"class":"ArrayPropertyValue","arrayCount":1,"arrayValues":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"0":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"2f48981a-d752-4b96-b67f-d0206b2a7681","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"headerVersion":1,"instancePropertyCategory":"ARRAY","typeGUID":"0428b5d