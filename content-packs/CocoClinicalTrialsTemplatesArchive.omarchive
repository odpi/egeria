pertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Blood pressure of patient (systolic and diastolic)."},"versionIdentifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"6.1-SNAPSHOT"},"qualifiedName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"GlossaryTerm::ClinicalTrialTerminology::PatientBloodPressure"},"displayName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Patient Blood Pressure"},"usage":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Acts as one of the standard mechanism for measuring the health of a patient in a clinical trial."},"description":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Blood pressure is the pressure of circulating blood against the walls of blood vessels. Most of this pressure results from the heart pumping blood through the circulatory system. Blood pressure is expressed in terms of the systolic pressure over diastolic pressure in the cardiac cycle. It is measured in millimetres of mercury above the surrounding atmospheric pressure, or in kilopascals. The difference between the systolic and diastolic pressures is known as pulse pressure, while the average pressure during a cardiac cycle is known as mean arterial pressure."},"abbreviation":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"PatientBloodPressure"}}},"status":"ACTIVE"},{"class":"EntityDetail","headerVersion":1,"type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"ENTITY_DEF","typeDefGUID":"0db3e6ec-f5ef-4d75-ae38-b7ee6fd6ec0a","typeDefName":"GlossaryTerm","typeDefVersion":1},"instanceProvenanceType":"CONTENT_PACK","metadataCollectionId":"74a786b2-d6d7-401d-b8c1-7d798f752c55","metadataCollectionName":"Coco Pharmaceuticals Clinical Trials Templates","createdBy":"Egeria Project","updatedBy":"Egeria Project","maintainedBy":["Egeria Project"],"createTime":1639984840038,"updateTime":1639984840038,"version":1784575067063,"guid":"45250f71-21ed-44d0-9795-a365baf49b92","classifications":[{"class":"Classification","headerVersion":1,"type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"CLASSIFICATION_DEF","typeDefGUID":"93b293c3-1185-4921-aa1c-237d3f0a5d5c","typeDefName":"TemplateSubstitute","typeDefVersion":1},"instanceProvenanceType":"CONTENT_PACK","metadataCollectionId":"74a786b2-d6d7-401d-b8c1-7d798f752c55","metadataCollectionName":"Coco Pharmaceuticals Clinical Trials Templates","createdBy":"Egeria Project","updatedBy":"Egeria Project","maintainedBy":["Egeria Project"],"createTime":1639984840038,"updateTime":1639984840038,"version":1784575067063,"classificationOrigin":"ASSIGNED","name":"TemplateSubstitute","status":"ACTIVE"},{"class":"Classification","headerVersion":1,"type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"CLASSIFICATION_DEF","typeDefGUID":"aa44f302-2e43-4669-a1e7-edaae414fc6e","typeDefName":"Ancho