 reporting company. This assessment allows a company to establish which operations and sources cause direct and indirect emissions, and to decide which indirect emissions to include that are a consequence of its operations. (Chapter 4) \n","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"displayName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Operational boundaries","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"qualifiedName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"GlossaryTerm::Operational boundaries","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"summary":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"The boundaries that determine the direct and indirect emissions associated with operations  by the reporting company. ","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"versionIdentifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"6.3-SNAPSHOT","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"ENTITY_DEF","typeDefGUID":"0db3e6ec-f5ef-4d75-ae38-b7ee6fd6ec0a","typeDefName":"GlossaryTerm","typeDefVersion":1},"updateTime":1639984840038,"updatedBy":"Egeria Project","version":1787846092948},{"class":"EntityDetail","classifications":[{"class":"Classification","classificationOrigin":"ASSIGNED","createTime":1639984840038,"createdBy":"Egeria Project","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"be351568-97ec-4c34-bca5-aff93f326d9e","metadataCollectionName":"Coco Pharmaceuticals Sustainability Project","name":"Anchors","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"anchorDomainName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"AuthoredReferenceable","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"anchorScopeGUIDs":{"class":"ArrayPropertyValue","arrayCount":1,"arrayValues":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"0":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"2f48981a-d752-4b96-b67f-d0206b2a7681","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"headerVersion":1,"instancePropertyCategory":"ARRAY","typeGUID":"0428b5d3-f824-459c-b7f5-f8151de59707","typeName":"array<string>"},"anchorTypeName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"GlossaryTerm","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"CLASSIFICATION_DEF","typeDefGUID":"aa44f302-2e43-4669-a1e7-edaae414fc6e","typeDefName":"Anchors","typeDefVersion":1},"updateTime":1639984840038,"updatedBy":"Egeria Project","version":1787846092948}],"createTime":1639984840038,"createdBy":"Egeria Project","guid":"7adc6dc9-28e2-42de-913f-8849a0ce766b","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"be351568-97ec-4c34-bca5-aff93f326d9e","metadataCollectionName":"Coco Pharmaceuticals Sustainability Project","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"description":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Operational Control. A company has operational control over an operation if the former or one of its subsidiaries (see Table 1 for definitions of financial accounting categories) has the full authority to introduce and implement its operating policies at the operation. This criterion is consistent with the current accounting and reporting practice of many companies that report on emissions from facilities, which they operate (i.e., for which they hold the operating license). It is expected that except in very rare circumstances, if the company or one of its subsidiaries is the operator of a facility, it will have the full authority to introduce and implement its operating policies and thus has operational control. \nIt should be emphasized that having operational control does not mean that a company necessarily has authority to make all decisions concerning an operation. For example, big capital investments will likely require the approval of all the partners that have joint financial control. Operational control does mean that a company has the authority to introduce and implement its operating policies. \nGovernment regulatory programs generally require reporting based on operational control at either facility level or geographic.","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"displayName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Operational Control","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"qualifiedName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"GlossaryTerm::Operational Control","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"summary":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"implement operational policies.","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"versionIdentifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"6.3-SNAPSHOT","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"}}},"status":"ACTIVE","type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"ENTITY_DEF","typeDefGUID":"0db3e6ec-f5ef-4d75-ae38-b7ee6fd6ec0a","typeDefName":"GlossaryTerm","typeDefVersion":1},"updateTime":1639984840038,"updatedBy":"Egeria Project","version":1787846092948},{"class":"EntityDetail","classifications":[{"class":"Classification","classificationOrigin":"ASSIGNED","createTime":1639984840038,"createdBy":"Egeria Project","headerVersion":1,"instanceProvenanceType":"CONTENT_PACK","maintainedBy":["Egeria Project"],"metadataCollectionId":"be351568-97ec-4c34-bca5-aff93f326d9e","metadataCollectionName":"Coco Pharmaceuticals Sustainability Project","name":"Anchors","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"anchorDomainName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"AuthoredReferenceable","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string"},"anchorScopeGUIDs":{"class":"ArrayPropertyValue","arrayCount":1,"arrayValues":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"0":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"2f48981a-d752-4b96-b67f-d0206b2a