lue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"41e28baf-d5df-4e4e-89ae-8c20f3ac7f29"}}}}}},"status":"ACTIVE"}],"properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"summary":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"A set of EU directives specifying who must report on what."},"versionIdentifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"6.1-SNAPSHOT"},"qualifiedName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"GlossaryTerm::Corporate Sustainability Reporting Directive"},"displayName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Corporate Sustainability Reporting Directive"},"description":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Key requirements include: - Yearly check-in;- Reporting scope - entire value chain;- Mandatory due diligence; - Double materiality assessment; - A second opinion - expert third-party review; - Incremental roll-out\n\nCompliance timeline:;- 2024: All large companies already covered by the NFRD that meet at least two of the following three requirements: 500 or more employees; 40 million EUR in net turnover; 20 million EUR in assets. - 2025: All large companies that meet at least two of the following three requirements: 250 or more employees; 40 million EUR in net turnover; 20 million EUR in assets. - 2026: Listed small and medium-sized enterprises (SMEs)* that meet at least two of the following requirements: Over 10 employees; Over 700 000 EUR net revenue; Over 350 000 EUR in assets.\n * SMEs will have a separated and simplified reporting standard to lowering their threshold to start reporting.\n - 2028: Non - EU companies that: 150 million EUR in net turnover in the EU if they have at least one subsidiary or branch in the EU."},"abbreviation":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"CSRD"}}},"status":"ACTIVE"},{"class":"EntityDetail","headerVersion":1,"type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"ENTITY_DEF","typeDefGUID":"0db3e6ec-f5ef-4d75-ae38-b7ee6fd6ec0a","typeDefName":"GlossaryTerm","typeDefVersion":1},"instanceProvenanceType":"CONTENT_PACK","metadataCollectionId":"be351568-97ec-4c34-bca5-aff93f326d9e","metadataCollectionName":"Coco Pharmaceuticals Sustainability Project","createdBy":"Egeria Project","updatedBy":"Egeria Project","maintainedBy":["Egeria Project"],"createTime":1639984840038,"updateTime":1639984840038,"version":1784477410099,"guid":"6f4f46f6-7fbf-4be9-91ad-93aae50687db","classifications":[{"class":"Classification","headerVersion":1,"type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"CLASSIFICATION_DEF","typeDefGUID":"aa44f302-2e43-4669-a1e7-edaae414fc6e","typeDefName":"Anchors","typeDefVersion":1},"instanceProvenanceType":"CONTENT_PACK","metadataCollectionId":"be351568-9