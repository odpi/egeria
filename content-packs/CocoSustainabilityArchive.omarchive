1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Double counting"}}},"status":"ACTIVE"},{"class":"EntityDetail","headerVersion":1,"type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"ENTITY_DEF","typeDefGUID":"0db3e6ec-f5ef-4d75-ae38-b7ee6fd6ec0a","typeDefName":"GlossaryTerm","typeDefVersion":1},"instanceProvenanceType":"CONTENT_PACK","metadataCollectionId":"be351568-97ec-4c34-bca5-aff93f326d9e","metadataCollectionName":"Coco Pharmaceuticals Sustainability Project","createdBy":"Egeria Project","updatedBy":"Egeria Project","maintainedBy":["Egeria Project"],"createTime":1639984840038,"updateTime":1639984840038,"version":1784477410099,"guid":"4e77213c-cd39-4b71-8504-c1ecc61d2125","classifications":[{"class":"Classification","headerVersion":1,"type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"CLASSIFICATION_DEF","typeDefGUID":"aa44f302-2e43-4669-a1e7-edaae414fc6e","typeDefName":"Anchors","typeDefVersion":1},"instanceProvenanceType":"CONTENT_PACK","metadataCollectionId":"be351568-97ec-4c34-bca5-aff93f326d9e","metadataCollectionName":"Coco Pharmaceuticals Sustainability Project","createdBy":"Egeria Project","updatedBy":"Egeria Project","maintainedBy":["Egeria Project"],"createTime":1639984840038,"updateTime":1639984840038,"version":1784477410099,"classificationOrigin":"ASSIGNED","name":"Anchors","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"anchorTypeName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"GlossaryTerm"},"anchorDomainName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"AuthoredReferenceable"},"anchorScopeGUIDs":{"class":"ArrayPropertyValue","headerVersion":1,"instancePropertyCategory":"ARRAY","typeGUID":"0428b5d3-f824-459c-b7f5-f8151de59707","typeName":"array<string>","arrayCount":1,"arrayValues":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"0":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"41e28baf-d5df-4e4e-89ae-8c20f3ac7f29"}}}}}},"status":"ACTIVE"}],"properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"summary":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Used to determine which ESRS requirements are relevant to an organization."},"description":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"When it comes to reporting under the ESRS, companies must first perform a double materiality assessment. This assessment helps determine which ESRS requirements are relevant for your organization specifically. There are two types of materiality that companies need to consider: 1. Impact materiality: All about how your company’s actions impact on people and planet in the short, medium, and long term. And remember, it’s not just about your own operation; you also need to assess the impact your entire value chain. 2. Financial impact: Here, the focus shifts to how sustainability issues impact your business financially. This includes factors such as your company’s growth, performance, and cost of capital in the short, medium, and long term. By combining these two factors, you can figure out which risks and opportunities are material and should be included in your reporting.It’s important to establish appropriate thresholds to help you make this decision, such as the likelihood of occurrence and the potential financial effect.This way, you can ensure that you include important information in your reports."},"versionIdentifier":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"6.1-SNAPSHOT"},"qualifiedName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"GlossaryTerm::Double Materiality Requirement"},"displayName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"Double Materiality Requirement"}}},"status":"ACTIVE"},{"class":"EntityDetail","headerVersion":1,"type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"ENTITY_DEF","typeDefGUID":"0db3e6ec-f5ef-4d75-ae38-b7ee6fd6ec0a","typeDefName":"GlossaryTerm","typeDefVersion":1},"instanceProvenanceType":"CONTENT_PACK","metadataCollectionId":"be351568-97ec-4c34-bca5-aff93f326d9e","metadataCollectionName":"Coco Pharmaceuticals Sustainability Project","createdBy":"Egeria Project","updatedBy":"Egeria Project","maintainedBy":["Egeria Project"],"createTime":1639984840038,"updateTime":1639984840038,"version":1784477410099,"guid":"4ccf8f81-fde3-425f-a423-486656cc4c2a","classifications":[{"class":"Classification","headerVersion":1,"type":{"class":"InstanceType","headerVersion":1,"typeDefCategory":"CLASSIFICATION_DEF","typeDefGUID":"aa44f302-2e43-4669-a1e7-edaae414fc6e","typeDefName":"Anchors","typeDefVersion":1},"instanceProvenanceType":"CONTENT_PACK","metadataCollectionId":"be351568-97ec-4c34-bca5-aff93f326d9e","metadataCollectionName":"Coco Pharmaceuticals Sustainability Project","createdBy":"Egeria Project","updatedBy":"Egeria Project","maintainedBy":["Egeria Project"],"createTime":1639984840038,"updateTime":1639984840038,"version":1784477410099,"classificationOrigin":"ASSIGNED","name":"Anchors","properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"anchorTypeName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"GlossaryTerm"},"anchorDomainName":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"AuthoredReferenceable"},"anchorScopeGUIDs":{"class":"ArrayPropertyValue","headerVersion":1,"instancePropertyCategory":"ARRAY","typeGUID":"0428b5d3-f824-459c-b7f5-f8151de59707","typeName":"array<string>","arrayCount":1,"arrayValues":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"0":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory":"OM_PRIMITIVE_TYPE_STRING","primitiveValue":"41e28baf-d5df-4e4e-89ae-8c20f3ac7f29"}}}}}},"status":"ACTIVE"}],"properties":{"class":"InstanceProperties","headerVersion":1,"instanceProperties":{"summary":{"class":"PrimitivePropertyValue","headerVersion":1,"instancePropertyCategory":"PRIMITIVE","typeGUID":"b34a64b9-554a-42b1-8f8a-7d5c2339f9c4","typeName":"string","primitiveDefCategory