<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
        Both servers send their audit log here through the SLF4J audit log destination, and it is written to
        one file that can be read while a run is in progress.  That matters in this suite because most of what
        it tests happens somewhere else: the test asks the integration daemon to refresh Darwin and then
        checks the repository, and when an assertion fails the reason is in the integration daemon's audit log
        - which data flows Darwin derived (DARWIN-PRODUCT-DEPENDENCY-MANAGER-0012), which dependencies it
        created (0004), which supply chains it filled in (0006, 0014), which exceptions it raised (0007) and
        the tallies for each level (0010, 0015).  Gradle buffers a test JVM's console output until the task ends, so on a run that is stuck the
        console alone tells you nothing until it is too late.

        The file-based audit log destination is deliberately not used: it writes one file per audit record.
    -->
    <appender name="AUDIT_LOG_FILE" class="ch.qos.logback.core.FileAppender">
        <file>build/darwin-fvt-data/logs/audit.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.odpi.openmetadata.frameworks.auditlog" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_LOG_FILE" />
    </logger>

    <logger name="org.odpi.openmetadata.darwinfvt" level="INFO" />


    <root level="warn">
        <appender-ref ref="STDOUT" />
    </root>

</configuration>
