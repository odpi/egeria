<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
        Both servers send their audit log here through the SLF4J audit log destination, and it is written
        to one file that can be read while a run is in progress.  That matters in this suite because most of
        what it tests happens somewhere else: the test publishes a document to the integration daemon and
        then waits, and when the wait expires the reason is in the audit log of the
        integration daemon - whether the connector started, what the cataloguer made of the document, and
        what the store did with it.  Gradle buffers a test JVM's console output until the
        task ends, so on a run that is stuck the console alone tells you nothing until it is too late.

        The file-based audit log destination is deliberately not used: it writes one file per audit record -
        hundreds during the start-up of two servers alone.
    -->
    <appender name="AUDIT_LOG_FILE" class="ch.qos.logback.core.FileAppender">
        <file>build/bitol-fvt-data/logs/audit.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.odpi.openmetadata.frameworks.auditlog" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_LOG_FILE" />
    </logger>

    <logger name="org.odpi.openmetadata.bitolfvt" level="INFO" />


    <root level="warn">
        <appender-ref ref="STDOUT" />
    </root>

</configuration>
