###
###  User directory for the auth-fvt suite.
###
###  This file is the SOURCE copy and is never used directly: OMAGPlatformExtension copies it into the
###  module's build directory before the platform starts, and points the platform at the copy.  That is
###  deliberate - a password change rewrites the user directory in place (see YAMLSecretsStoreConnector's
###  saveUser), so running the tests against this file would modify the repository's own source tree and
###  make the second run behave differently from the first.
###
###  Every account here starts with a clearPassword.  Changing a password replaces that with an
###  encryptedPassword, which is one of the behaviours the suite checks.
###
secretsCollections:
  authFvtUserDirectory:
    refreshTimeInterval: 0
    users:
      fvtactive:
        userAccountStatus: AVAILABLE
        userAccountType: EMPLOYEE
        userName: Active Alice
        secrets:
          clearPassword: fvtsecret
      fvtchanger:
        userAccountStatus: AVAILABLE
        userAccountType: EMPLOYEE
        userName: Changing Charlie
        secrets:
          clearPassword: fvtsecret
      fvtwrongpassword:
        userAccountStatus: AVAILABLE
        userAccountType: EMPLOYEE
        userName: Fumbling Fred
        secrets:
          clearPassword: fvtsecret
      fvtexpired:
        userAccountStatus: CREDENTIALS_EXPIRED
        userAccountType: EMPLOYEE
        userName: Expired Edward
        secrets:
          clearPassword: fvtsecret
      fvtdisabled:
        userAccountStatus: DISABLED
        userAccountType: EMPLOYEE
        userName: Disabled Dora
        secrets:
          clearPassword: fvtsecret
      fvtlocked:
        userAccountStatus: LOCKED
        userAccountType: EMPLOYEE
        userName: Locked Lucy
        secrets:
          clearPassword: fvtsecret
