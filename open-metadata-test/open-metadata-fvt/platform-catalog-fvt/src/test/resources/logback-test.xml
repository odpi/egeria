<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
        Every server sends its audit log here through the SLF4J audit log destination, and it is written to
        one file that can be read while a run is in progress.  That matters in this suite because most of
        what it tests happens somewhere else: the test asks the integration daemon to refresh the cataloguer
        and then checks the repository.  When an assertion fails, the reason is usually in the integration
        daemon's audit log - which platform the cataloguer picked up (OMAG-CONNECTORS-0006), which servers it
        created (OMAG-CONNECTORS-0010) and the exceptions it swallowed (OMAG-CONNECTORS-0004).  Gradle
        buffers a test JVM's console output until the task ends, so on a run that is stuck the console alone
        tells you nothing until it is too late.

        The file-based audit log destination is deliberately not used: it writes one file per audit record.
    -->
    <appender name="AUDIT_LOG_FILE" class="ch.qos.logback.core.FileAppender">
        <file>build/platform-catalog-fvt-data/logs/audit.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.odpi.openmetadata.frameworks.auditlog" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_LOG_FILE" />
    </logger>

    <logger name="org.odpi.openmetadata.platformcatalogfvt" level="INFO" />

    <root level="warn">
        <appender-ref ref="STDOUT" />
    </root>

</configuration>
