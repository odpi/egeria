---
#
# SPDX-License-Identifier: Apache-2.0
# Copyright Contributors to the Egeria project.
#
# This suite's own copy of the platform's server secrets store.
#
# It has to live at exactly this path.  The connections that the Egeria content pack lays down for the
# OMAG Server Platform Cataloguer - and for the SoftwareServerPlatform asset the cataloguer creates for the
# local platform - name "secrets/egeria-servers.omsecrets" as a path relative to the platform's working
# directory, which for a Gradle "test" task is this module's project directory.  Pointing the
# egeriaServersSecretsStore placeholder somewhere else does not change that: the content pack's own
# connections do not go through the placeholder.
#
# The collections here supply a userId only, with no tokenAPI.  The shipped store's
# OMAGServerPlatformCataloguer collection fetches a bearer token from https://localhost:7443/api/token,
# which is the default dev platform's token endpoint - this suite's platform has no token endpoint (the
# user-authn module is excluded from its classpath) and listens on a port allocated at run time.  With no
# token to fetch, the cataloguer's REST calls go out unauthenticated, which is what this suite's permit-all
# platform expects.
#
secretsCollections:
  PostgreSQLRepository:
    refreshTimeInterval: 10
    secrets:
      userId: "egeria_user"
      clearPassword: "user4egeria"
  EgeriaServers:
    refreshTimeInterval: 50
    secrets:
      userId: "egerianpa"
  OMAGServerPlatformCataloguer:
    refreshTimeInterval: 50
    secrets:
      userId: "omagspcatnpa"
