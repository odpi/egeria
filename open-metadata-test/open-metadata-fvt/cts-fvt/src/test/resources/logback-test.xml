<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
        Both servers send their audit log here through the SLF4J audit log destination, and it is written to
        one file that can be read while a run is in progress.  That matters more here than in the sibling
        suites: a conformance run is mostly waiting - the workbench does not start until the technology
        under test registers in the cohort - and when it waits forever the reason is always in the audit
        log.  Gradle buffers a test JVM's console output until the task ends, so on a run that hangs the
        console alone tells you nothing until it is too late to be useful.

        The file-based audit log destination is deliberately not used: it writes one file per audit record,
        which is thousands of files for a start-up and far more for a full workbench run.
    -->
    <appender name="AUDIT_LOG_FILE" class="ch.qos.logback.core.FileAppender">
        <file>build/cts-fvt-data/logs/audit.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.odpi.openmetadata.frameworks.auditlog" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_LOG_FILE" />
    </logger>

    <logger name="org.odpi.openmetadata.ctsfvt" level="INFO" />

    <!--
        The Kafka event consumer decides, on its first partition assignment, whether to rewind to the point
        the connector started - which is what stops a consumer that joined a moment too late from reading
        straight past a cohort registration.  The two outcomes that matter are reported at warn by the
        connector itself now, so they show up anywhere: a rewind having been needed, and the correction
        having failed and been swallowed.

        This turns the rest of that decision up to INFO as well - which offset was queried for, what was
        found, and which branch was taken.  On a run that records no test cases, that trail is what
        distinguishes a cohort that never formed from one that formed and whose registration was missed, and
        it costs a handful of lines per topic at start-up.
    -->
    <logger name="org.odpi.openmetadata.adapters.eventbus.topic.kafka" level="INFO" />

    <root level="warn">
        <appender-ref ref="STDOUT" />
    </root>

</configuration>
