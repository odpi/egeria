<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
        All four servers send their audit log here through the SLF4J audit log destination, and it is written
        to one file that can be read while a run is in progress.  That matters in this suite because most of
        what it tests happens somewhere else: the test asks the view server to start a governance action and
        then waits, and when the wait expires the reason is in the audit log of the engine host or the
        integration daemon - whether the engine picked the action up, whether a connector could be built for
        it, and what the connector said when it ran.  Gradle buffers a test JVM's console output until the
        task ends, so on a run that is stuck the console alone tells you nothing until it is too late.

        The file-based audit log destination is deliberately not used: it writes one file per audit record -
        hundreds during the start-up of four servers alone.
    -->
    <appender name="AUDIT_LOG_FILE" class="ch.qos.logback.core.FileAppender">
        <file>build/openlineage-fvt-data/logs/audit.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.odpi.openmetadata.frameworks.auditlog" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_LOG_FILE" />
    </logger>

    <logger name="org.odpi.openmetadata.openlineagefvt" level="INFO" />

    <!--
        Kafka diagnostics, written to their own file so that the console stays readable.  The Kafka listener test
        has lost an event intermittently, and the audit log cannot say why: it records neither when the consumer
        was assigned its partition, nor where it chose to start reading, nor whether the event ever reached the
        listener connector.  These loggers record all three.
    -->
    <appender name="KAFKA_LOG_FILE" class="ch.qos.logback.core.FileAppender">
        <file>build/openlineage-fvt-data/logs/kafka.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.apache.kafka.clients.consumer.internals.ConsumerCoordinator" level="INFO" additivity="false">
        <appender-ref ref="KAFKA_LOG_FILE" />
    </logger>
    <logger name="org.apache.kafka.clients.consumer.internals.SubscriptionState" level="INFO" additivity="false">
        <appender-ref ref="KAFKA_LOG_FILE" />
    </logger>
    <logger name="org.apache.kafka.clients.consumer.internals.ClassicKafkaConsumer" level="INFO" additivity="false">
        <appender-ref ref="KAFKA_LOG_FILE" />
    </logger>
    <logger name="org.odpi.openmetadata.adapters.eventbus.topic.kafka" level="INFO" additivity="false">
        <appender-ref ref="KAFKA_LOG_FILE" />
    </logger>
    <logger name="org.odpi.openmetadata.adapters.connectors.integration.openlineage.OpenLineageEventReceiverIntegrationConnector" level="DEBUG" additivity="false">
        <appender-ref ref="KAFKA_LOG_FILE" />
    </logger>


    <root level="warn">
        <appender-ref ref="STDOUT" />
    </root>

</configuration>
