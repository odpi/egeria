###
# =====================================================================================================================
# Catalog DuckDB Database
#

###
# @name initiate Catalog DuckDB Database GovernanceActionProcess
# DuckDB is embedded/file-based - there is no server tier, so this catalogs a single ".duckdb" file directly.
# Update databasePath for your own environment.

POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/automated-curation/governance-action-processes/initiate
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "processQualifiedName": "DuckDBDatabase::CreateAsCatalogTargetGovernanceActionProcess",
  "requestParameters" : {
    "databasePath" : "/tmp/duckdb_test/egeria_test.duckdb",
    "databaseName" : "EgeriaTestDuckDB",
    "databaseDescription" : "DuckDB embedded database.",
    "versionIdentifier" : "1.0",
    "secretsStorePathName" : "secrets/integration.omsecrets",
    "secretsCollectionName" : "PostgreSQL Server Secret"
  }
}

> {% client.global.set("duckdbProcessGUID", response.body.guid); %}

###
# @name getGovernanceActionProcessGraph
# Retrieve the governance action process metadata element with the supplied unique identifier
# along with the flow definition describing its implementation.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/governance-officer/governance-action-processes/{{duckdbProcessGUID}}/graph
Authorization: Bearer {{token}}

###
# @name getActiveEngineActions
# Retrieve the engine actions that are still in process.
GET {{baseURL}}/servers/{{viewServer}}/api/open-metadata/automated-curation/engine-actions/active?startFrom=0&pageSize=5
Authorization: Bearer {{token}}


###
# @name refreshConnectors (DuckDB database)
# Issue a refresh() request on all connectors running in the integration daemon, or a specific connector if the connector name is specified.
# DuckDB does not persist ATTACH-ed data sources between sessions - if attachStatements are configured on the catalog
# target's configuration properties, run this refresh a second time after the JDBC refresh below has completed, so
# that federation discovery sees the databases/views the friendship connector has now catalogued.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/runtime-manager/integration-daemons/{{integrationDaemonGUID}}/integration-connectors/refresh
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NameRequestBody",
  "name" : "DuckDBDatabaseCataloguer"
}


###
# @name refreshConnectors (DuckDB native schema/tables/columns)
# Issue a refresh() request on all connectors running in the integration daemon, or a specific connector if the connector name is specified.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/runtime-manager/integration-daemons/{{integrationDaemonGUID}}/integration-connectors/refresh
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NameRequestBody",
  "name" : "JDBCDatabaseCataloguer"
}
