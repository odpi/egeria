# Egeria-coco-data-hub
# This file creates a data sharing hub with information from the file system, postgress database and unity catalog.
# To set up, create a directory under plaform called coco-data-lake.  Then run though Egeria-test-catalog-processes.http
# to create the assets we need.

@baseURL=https://localhost:7443
@viewServer=view-server

###
# =====================================================================================================================
# Manage the authentication token.  Run this request to create/refresh the token.

# @name Token (RequestBody)
POST {{baseURL}}/api/token
Content-Type: application/json

{
  "userId" : "peterprofile",
  "password" : "secret"
}

> {% client.global.set("token", response.body); %}




###
# =====================================================================================================================
# Create Collections: https://egeria-project.org/concepts/collection


###
# @name createCollection (own anchor)
# Create a new generic collection.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/collection-manager/collections
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NewElementRequestBody",
  "isOwnAnchor" : true,
  "properties": {
    "class" : "DataSharingHubProperties",
    "qualifiedName": "CocoPharma::DataSharingHub::coco-data-hub",
    "identifier" : "coco-data-hub",
    "displayName" : "coco-data-hub"
  }
}

> {% client.global.set("cocoDataHubGUID", response.body.guid); %}

###
# @name getCollectionByGUID
# Return the properties of a specific collection. Request body is optional
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/collection-manager/collections/{{cocoDataHubGUID}}/retrieve
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "GetRequestBody",
  "asOfTime" : "{{$isoTimestamp}}",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false
}



###
# =====================================================================================================================
# Add data stores
# https://egeria-project.org/types/00040-Software-Servers/

###
# @name get coco-data-lake ByName
# Returns the list of assets with a particular name.
#
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/asset-maker/assets/by-name
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "FilterRequestBody",
  "filter" : "coco-data-lake",
  "startFrom" : 0,
  "pageSize": 10,
  "metadataElementTypeName": "FileFolder",
  "graphQueryDepth" : 0
}

> {% client.global.set("cocoDataLakeGUID", response.body.elements[0].elementHeader.guid); %}

###
# @name addToCollection
# Add coco data lake to a collection.  The request body is optional
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/collection-manager/collections/{{cocoDataHubGUID}}/members/{{cocoDataLakeGUID}}/attach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NewRelationshipRequestBody",
  "properties" : {
    "class": "CollectionMembershipProperties",
    "membershipRationale": "Holds files for clinical trials",
    "createdBy": "Liskov"
  }
}

###
# @name get cocoPharma ByName
# Returns the list of assets with a particular name.
#
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/asset-maker/assets/by-name
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "FilterRequestBody",
  "filter" : "coco_pharma",
  "startFrom" : 0,
  "pageSize": 10,
  "metadataElementTypeName": "RelationalDatabase",
  "graphQueryDepth" : 0
}

> {% client.global.set("cocoPharmaGUID", response.body.elements[0].elementHeader.guid); %}

###
# @name addToCollection
# Add coco data lake to a collection.  The request body is optional
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/collection-manager/collections/{{cocoDataHubGUID}}/members/{{cocoPharmaGUID}}/attach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NewRelationshipRequestBody",
  "properties" : {
    "class": "CollectionMembershipProperties",
    "membershipRationale": "Holds shared databases",
    "createdBy": "Liskov"
  }
}

###
# @name get Unity catalog clinical-trials catalog ByName
# Returns the list of assets with a particular name.
#
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/asset-maker/assets/by-name
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "FilterRequestBody",
  "filter" : "clinical_trials",
  "startFrom" : 0,
  "pageSize": 10,
  "metadataElementTypeName": "Database",
  "graphQueryDepth" : 0
}

> {% client.global.set("clinicalTrialsGUID", response.body.elements[0].elementHeader.guid); %}


###
# @name addToCollection
# Add coco data lake to a collection.  The request body is optional
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/collection-manager/collections/{{cocoDataHubGUID}}/members/{{clinicalTrialsGUID}}/attach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NewRelationshipRequestBody",
  "properties" : {
    "class": "CollectionMembershipProperties",
    "membershipRationale": "Holds shared databases",
    "createdBy": "Liskov"
  }
}

###
# =====================================================================================================================
# Refresh Liskov connector

###
# @name getServersByName
# Returns the list of servers with a particular name.  The name is specified in the filter.

POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/runtime-manager/software-servers/by-name
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "filter" : "integration-daemon"
}

> {% client.global.set("integrationDaemonGUID", response.body.elements[0].elementHeader.guid); %}


###
# @name refreshConnectors
# Issue a refresh() request on all connectors running in the integration daemon, or a specific connector if the connector name is specified.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/runtime-manager/integration-daemons/{{integrationDaemonGUID}}/integration-connectors/refresh
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NameRequestBody",
  "name" : "DataSharingHubManager"
}



