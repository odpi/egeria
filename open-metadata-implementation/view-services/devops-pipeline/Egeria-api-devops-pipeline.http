# Egeria-devops-pipeline-api

@baseURL=https://localhost:7443
@viewServer=view-server

###
# =====================================================================================================================
# Manage the authentication token.  Run this request to create/refresh the token.

# @name Token (RequestBody)
POST {{baseURL}}/api/token
Content-Type: application/json

{
  "userId" : "peterprofile",
  "password" : "secret"
}

> {% client.global.set("token", response.body); %}

###
# =====================================================================================================================
# Work with Storage Volumes
# https://egeria-project.org/concepts/storage-volume

@storageVolumeGUID=add guid here
@itInfrastructureGUID=add guid here
@dataStoreGUID=add guid here

###
# @name createStorageVolume
# Create a storage volume.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/devops-pipeline/storage-volumes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NewElementRequestBody",
  "properties": {
    "class": "StorageVolumeProperties",
    "qualifiedName": "StorageVolume::add unique name here",
    "displayName": "add short name here",
    "description": "add description here",
    "storageCapacity": 0,
    "units": "add units here",
    "relativeUncertainty": 0,
    "absoluteUncertainty": 0,
    "additionalProperties": {
      "property1": "propertyValue1",
      "property2": "propertyValue2"
    },
    "effectiveFrom": "{{$isoTimestamp}}",
    "effectiveTo": "{{$isoTimestamp}}"
  },
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false
}

###
# @name createStorageVolumeFromTemplate
# Create a new metadata element to represent a storage volume using an existing metadata element as a template.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/devops-pipeline/storage-volumes/from-template
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "TemplateRequestBody",
  "templateGUID": "add guid here",
  "placeholderPropertyValues": {
    "placeholder1": "propertyValue1",
    "placeholder2": "propertyValue2"
  },
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false
}

###
# @name updateStorageVolume
# Update the properties of a storage volume.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/devops-pipeline/storage-volumes/{{storageVolumeGUID}}/update
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "UpdateElementRequestBody",
  "mergeUpdate": true,
  "properties": {
    "class": "StorageVolumeProperties",
    "displayName": "add short name here",
    "description": "add description here",
    "storageCapacity": 0,
    "units": "add units here"
  },
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false
}

###
# @name deleteStorageVolume
# Delete a storage volume.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/devops-pipeline/storage-volumes/{{storageVolumeGUID}}/delete
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "DeleteElementRequestBody",
  "cascadedDelete" : false,
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false
}

###
# @name getStorageVolumesByName
# Returns the list of storage volumes with a particular name.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/devops-pipeline/storage-volumes/by-name
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "FilterRequestBody",
  "filter" : "Add name here",
  "startFrom" : 0,
  "pageSize": 10,
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false,
  "limitResultsByStatus" : ["ACTIVE"],
  "sequencingOrder" : "PROPERTY_ASCENDING",
  "sequencingProperty" : "qualifiedName"
}

###
# @name findStorageVolumes
# Retrieve the list of storage volume metadata elements that contain the search string.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/devops-pipeline/storage-volumes/by-search-string
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "SearchStringRequestBody",
  "searchString" : "Add value here",
  "startsWith" : false,
  "endsWith" : false,
  "ignoreCase" : true,
  "startFrom" : 0,
  "pageSize": 10,
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false,
  "limitResultsByStatus" : ["ACTIVE"],
  "sequencingOrder" : "PROPERTY_ASCENDING",
  "sequencingProperty" : "qualifiedName"
}

