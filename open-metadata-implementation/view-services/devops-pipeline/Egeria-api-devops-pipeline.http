###
# ---------------------------------------------------------------------------------------------------------------------
# NetworkGatewayLink is a multi-link relationship - the attach always creates a new relationship and returns its GUID.
# The update and detach operations are addressed by that relationship GUID, not by the two end GUIDs.

###
# @name linkNetworkGateway
# Attach a network gateway to a network that it connects to.  Returns the new relationship GUID.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/devops-pipeline/network-gateways/{{networkGatewayGUID}}/network-gateway-links/{{networkGUID}}/attach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NewRelationshipRequestBody",
  "properties": {
    "class": "NetworkGatewayLinkProperties",
    "label": "add label",
    "description": "add description",
    "externalEndpointAddress": "add external address here",
    "internalEndpointAddress": "add internal address here",
    "effectiveFrom": "{{$isoTimestamp}}",
    "effectiveTo": "{{$isoTimestamp}}"
  },
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false
}

