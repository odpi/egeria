POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/devops-pipeline/operating-platforms/{{operatingPlatformGUID}}/update
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "UpdateElementRequestBody",
  "mergeUpdate": true,
  "properties": {
    "class": "OperatingPlatformProperties",
    "qualifiedName": "OperatingPlatform::add unique name here",
    "displayName": "add short name here",
    "description": "add description here",
    "operatingSystem": "add operating system name here",
    "operatingSystemPatchLevel": "add patch level here",
    "byteOrdering": "BIG_ENDIAN",
    "effectiveFrom": "{{$isoTimestamp}}",
    "effectiveTo": "{{$isoTimestamp}}"
  },
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false
}

