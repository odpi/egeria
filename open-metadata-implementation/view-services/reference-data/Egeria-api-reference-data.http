@validValueSetGUID=add guid here
@validValueMemberGUID=add guid here

###
# @name linkValidValueMember
# Attach a valid value to a valid value set.
#
# @param validValueSetGUID       unique identifier of the set (parent)
# @param validValueMemberGUID           unique identifier of the member
# Request body provides  description of the relationship.
#
# Returns void or
#  InvalidParameterException  one of the parameters is null or invalid.
#  PropertyServerException    a problem retrieving information from the property server(s).
#  UserNotAuthorizedException the requesting user is not authorized to issue this request.
#
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/reference-data/valid-values/{{validValueSetGUID}}/members/{{validValueMemberGUID}}/attach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NewRelationshipRequestBody",
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false,
  "properties": {
    "class": "AdjacentLocationProperties",
    "label": "",
    "description": "",
    "effectiveFrom": "{{$isoTimestamp}}",
    "effectiveTo": "{{$isoTimestamp}}"
  }
}


###
# @name detachValidValueMember
# Detach a valid value from a valid value set.
#
# @param validValueSetGUID       unique identifier of the set (parent)
# @param validValueMemberGUID           unique identifier of the member
# Request body provides  description of the relationship.
#
# Returns void or
#  InvalidParameterException  one of the parameters is null or invalid.
#  PropertyServerException    a problem retrieving information from the property server(s).
#  UserNotAuthorizedException the requesting user is not authorized to issue this request.
#
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/reference-data/valid-values/{{validValueSetGUID}}/members/{{validValueMemberGUID}}/detach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "DeleteRelationshipRequestBody",
  "deleteMethod": "LOOK_FOR_LINEAGE",
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false
}

###

@elementGUID=add guid here

###
# @name linkReferenceValueAssignment
# Attach a valid value to an element to be used as a tag/classification to help retrieve and organize the element.
# Request body is optional.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/reference-data/elements/{{elementGUID}}/reference-value-assignment/{{validValueDefinitionGUID}}/attach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NewRelationshipRequestBody",
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false,
  "properties": {
    "class": "ReferenceValueAssignmentProperties",
    "attributeName": "add attribute name here",
    "confidence": 100,
    "steward": "add steward here",
    "stewardTypeName": "add steward type name here",
    "stewardPropertyName": "add steward property name here",
    "notes": "add notes here",
    "effectiveFrom": "{{$isoTimestamp}}",
    "effectiveTo": "{{$isoTimestamp}}"
  }
}


###
# @name detachReferenceValueAssignment
# Remove a reference value assignment relationship between an element and a valid value. Request body is optional.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/reference-data/elements/{{elementGUID}}/reference-value-assignment/{{validValueDefinitionGUID}}/detach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "DeleteRelationshipRequestBody",
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false
}


###
# @name linkValidValuesAssignment
# Attach a valid value definition (typically a valid value set) to an element as its list of allowed values.
# Request body is optional.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/reference-data/elements/{{elementGUID}}/valid-values-assignment/{{validValueDefinitionGUID}}/attach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NewRelationshipRequestBody",
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false,
  "properties": {
    "class": "ValidValuesAssignmentProperties",
    "strictRequirement": true,
    "effectiveFrom": "{{$isoTimestamp}}",
    "effectiveTo": "{{$isoTimestamp}}"
  }
}


###
# @name detachValidValuesAssignment
# Remove a valid values assignment relationship between an element and a valid value definition. Request body is optional.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/reference-data/elements/{{elementGUID}}/valid-values-assignment/{{validValueDefinitionGUID}}/detach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "DeleteRelationshipRequestBody",
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false
}


###
# @name linkValidValueImplementation
# Link a valid value to an implementation element (typically an asset) that supports it. Request body is optional.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/reference-data/valid-values/{{validValueDefinitionGUID}}/implementation/elements/{{elementGUID}}/attach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NewRelationshipRequestBody",
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false,
  "properties": {
    "class": "ValidValuesImplementationProperties",
    "symbolicName": "add symbolic name here",
    "implementationValue": "add implementation value here",
    "additionalValues": {
      "property1" : "propertyValue1",
      "property2" : "propertyValue2"
    },
    "effectiveFrom": "{{$isoTimestamp}}",
    "effectiveTo": "{{$isoTimestamp}}"
  }
}


###
# @name detachValidValueImplementation
