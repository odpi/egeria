POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/reference-data/valid-values/{{validValueDefinitionGUID}}/implementation/elements/{{elementGUID}}/detach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "DeleteRelationshipRequestBody",
