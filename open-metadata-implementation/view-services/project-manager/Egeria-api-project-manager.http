# @name clearProjectKind
# Remove the project kind classification from a project.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/project-manager/projects/{{projectGUID}}/project-kind/remove
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "DeleteClassificationRequestBody",
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false
}

