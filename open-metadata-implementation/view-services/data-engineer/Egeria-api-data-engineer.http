POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/data-engineer/data-values/{{parentDataValueGUID}}/embedded-data-values/{{embeddedDataValueGUID}}/attach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NewRelationshipRequestBody",
  "properties": {
    "class" : "EmbeddedDataValueProperties",
    "label": "add label here",
    "description": "add description here",
    "position": 0,
    "effectiveFrom": "{{$isoTimestamp}}",
    "effectiveTo": "{{$isoTimestamp}}"
  },
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false
}

###
# @name detachEmbeddedDataValue
# Remove an embedded data value from its parent data value.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/data-engineer/data-values/{{parentDataValueGUID}}/embedded-data-values/{{embeddedDataValueGUID}}/detach
Authorization: Bearer {{token}}
