# Egeria-product-manager-api
# Manage the definition of a digital product (works with collection manager)

@baseURL=https://localhost:7443
@viewServer=view-server

###
# =====================================================================================================================
# Manage the authentication token.  Run this request to create/refresh the token.

# @name Token (RequestBody)
POST {{baseURL}}/api/token
Content-Type: application/json

{
  "userId" : "peterprofile",
  "password" : "secret"
}

> {% client.global.set("token", response.body); %}


###

@digitalProductGUID=xxx

###
# @name createDigitalProduct (collection manager)
# Create a new collection that represents a digital product.
# Note: the three dates: introductionDate, nextVersionDate and withdrawDate must be valid dates if specified,
# otherwise you will get a 400 error response
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/collections
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NewElementRequestBody",
  "isOwnAnchor" : true,
  "anchorScopeGUIDs" : ["optional GUID of search scope"],
  "parentGUID" : "xxx",
  "parentRelationshipTypeName" : "CollectionMembership",
  "parentAtEnd1": true,
  "properties": {
    "class" : "DigitalProductProperties",
    "qualifiedName": "DigitalProduct::Add product name here",
    "displayName" : "Product contents",
    "description" : "Add description of product and its expected usage here",
    "identifier" : "Add product identifier here",
    "productName" : "Add product name here",
    "category" : "Periodic Delta",
    "maturity" : "Add valid value here",
    "serviceLife" : "Add the estimated lifetime of the product",
    "introductionDate" : "date",
    "nextVersionDate": "date",
    "withdrawDate": "date",
    "currentVersion": "V0.1",
    "additionalProperties": {
      "property1Name" : "property1Value",
      "property2Name" : "property2Value"
    }
  },
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false
}

###
# @name updateDigitalProduct (collection manager)
# Update the properties of the DigitalProduct collection.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/collections/{{digitalProductGUID}}/update
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "UpdateElementRequestBody",
  "properties": {
    "class" : "DigitalProductProperties",
    "qualifiedName": "DigitalProduct::Add product name here",
    "displayName" : "Product contents",
    "description" : "Add description of product and its expected usage here",
    "userDefinedStatus" : "OBSOLETE",
    "identifier" : "Add product identifier here",
    "productName" : "Add product name here",
    "category" : "Periodic Delta",
    "maturity" : "Add valid value here",
    "serviceLife" : "Add the estimated lifetime of the product",
    "introductionDate" : "date",
    "nextVersionDate": "date",
    "withdrawDate": "date",
    "currentVersion": "V0.1",
    "additionalProperties": {
      "property1Name" : "property1Value",
      "property2Name" : "property2Value"
    }
  },
  "mergeUpdate": true,
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false
}

###
# @name updateDigitalProductStatus (collection manager)
# Update the status of the DigitalProduct collection.  There are two statuses to consider.  The content status
# describes the state of the product description.  The deploymentStatus covers the status of the technical work to
# implement the product's digital resources.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/collections/{{digitalProductGUID}}/update
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "UpdateElementRequestBody",
  "properties": {
    "class" : "DigitalProductProperties",
    "contentStatus": "APPROVED",
    "deploymentStatus": "UNDER_DEVELOPMENT"
  },
  "mergeUpdate": true
}


###
# =====================================================================================================================
# Digital products and their subscription types.  These requests build a product in one call, and add the
# subscription types that subscribers use to receive its data.  They follow the pattern of the Jacquard Digital
# Product Loom, so products built this way work with the Baudot subscription manager and the create/provision/cancel
# subscription governance services from the digital products content pack.
# =====================================================================================================================

@productManagerRoleGUID=add guid here
@productCommunityGUID=add guid here
@productFolderGUID=add guid here
@productFamilyGUID=add guid here
@questionGlossaryTermGUID=add guid here
@productAssetGUID=add guid here
@licenseTypeGUID=add guid here
@dataSpecGUID=add guid here

###
# @name createDigitalProduct
# Create a new digital product and link it to the elements that surround it.  The properties, classifications and
# parent are as for createCollection.  The extra fields name existing elements to link the new product to; each is
# optional:
#   productManagerGUID        - actor role that manages the product (AssignmentScope, owner)
#   productCommunityGUID      - community that discusses the product (ScopedBy); its note log receives the
#                               product's subscription notifications
#   collectionGUIDs           - collections the product is a member of, typically product catalog folders and
#                               digital product families (CollectionMembership)
#   questionGUIDs             - glossary terms for the questions the product answers (SupplementaryProperties)
#   productAssetGUID          - asset holding the product's data (CollectionMembership); the source for subscriptions
#   governanceDefinitionGUIDs - governance definitions the product is governed by, such as the license granted to
#                               subscribers (GovernedBy)
#   dataSpecGUID              - data specification describing the product's data (DataDescription)
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/digital-products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NewDigitalProductRequestBody",
  "isOwnAnchor" : true,
  "properties": {
    "class" : "DigitalProductProperties",
    "qualifiedName": "DigitalProduct::Add product name here",
    "displayName" : "Product contents",
    "description" : "Add description of product and its expected usage here",
    "identifier" : "Add product identifier here",
    "productName" : "Add product name here",
    "category" : "Periodic Delta",
    "introductionDate" : "{{$isoTimestamp}}",
    "currentVersion": "V0.1",
    "contentStatus": "ACTIVE",
    "deploymentStatus": "ACTIVE"
  },
  "productManagerGUID" : "{{productManagerRoleGUID}}",
  "productCommunityGUID" : "{{productCommunityGUID}}",
  "collectionGUIDs" : [ "{{productFolderGUID}}", "{{productFamilyGUID}}" ],
  "questionGUIDs" : [ "{{questionGlossaryTermGUID}}" ],
  "productAssetGUID" : "{{productAssetGUID}}",
  "governanceDefinitionGUIDs" : [ "{{licenseTypeGUID}}" ],
  "dataSpecGUID" : "{{dataSpecGUID}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false
}

###
# @name createOneTimeSubscription
# Add a one-time subscription type to the product: subscribers receive a single notification, and so a single
# delivery of the product's data - typically to evaluate the product.  The request body is optional.  Every field
# in it is optional: subscriptionManagerGUID defaults to the Baudot subscription manager from the content pack;
# identifier defaults to ONE-TIME-SUBSCRIPTION; licenseTypeGUID and serviceLevelObjectiveGUID default to the
# license type and service level objective that the product is governed by.  The unique identifier of the
# governance action process that creates a subscription of this type is returned.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/digital-products/{{digitalProductGUID}}/subscription-types/one-time
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NewSubscriptionTypeRequestBody",
  "identifier" : "EVALUATION-SUBSCRIPTION",
  "displayName" : "Evaluation subscription",
  "description" : "This subscription delivers the data to the target destination just once to allow an evaluation of the product data."
}

###
# @name createPeriodicSubscription
# Add a periodic subscription type to the product: subscribers receive a notification, and so a delivery of the
# product's data, every notificationInterval minutes.  A product offering more than one periodic subscription type
# (daily and weekly, say) needs a distinct identifier for each.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/digital-products/{{digitalProductGUID}}/subscription-types/periodic
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NewSubscriptionTypeRequestBody",
  "identifier" : "DAILY-REFRESH-SUBSCRIPTION",
  "displayName" : "Daily refresh subscription",
  "description" : "This subscription delivers the data to the target destination once a day.",
  "notificationInterval" : 1440
}

###
# @name createOngoingUpdateSubscription
# Add an ongoing update subscription type to the product: subscribers receive a notification, and so a delivery of
# the product's data, whenever one of the monitoredResourceGUIDs changes - but no more often than
# notificationInterval minutes.  The monitored resource is typically the product's asset.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/digital-products/{{digitalProductGUID}}/subscription-types/ongoing-update
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NewSubscriptionTypeRequestBody",
  "identifier" : "ONGOING-UPDATE-SUBSCRIPTION",
  "displayName" : "Ongoing update subscription",
  "description" : "This subscription delivers data updates to the target destination within an hour of receiving the new data.",
  "monitoredResourceGUIDs" : [ "{{productAssetGUID}}" ],
  "notificationInterval" : 10
}

###

@consumerDigitalProductGUID=add guid here
@consumedDigitalProductGUID=add guid here

###
# @name linkDigitalProductDependency
# Link two dependent digital products.  The linked elements are of type 'DigitalProduct' . Request body is optional.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/digital-products/{{consumerDigitalProductGUID}}/product-dependencies/{{consumedDigitalProductGUID}}/attach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NewRelationshipRequestBody",
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false,
  "properties": {
    "class": "DigitalPropertyDependencyProperties",
    "label": "add label here",
    "description": "add description here",
    "effectiveFrom": "{{$isoTimestamp}}",
    "effectiveTo": "{{$isoTimestamp}}"
  }
}


###
# @name detachDigitalProductDependency
# Unlink dependent digital products. Request body is optional.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/digital-products/{{consumerDigitalProductGUID}}/product-dependencies/{{consumedDigitalProductGUID}}/detach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "DeleteRelationshipRequestBody",
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false
}


###

@digitalProductManagerRoleGUID=Add guid here

###
# @name linkProductManager
# Attach a product manager role to a digital product. Request body is optional.
# This role acts as a placeholder in the organization.  It may be a PersonRole, TeamRole or ITProfileRole.
# People/Teams/Software Components can be assigned to the role at a later time.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/digital-products/{{digitalProductGUID}}/product-managers/{{digitalProductManagerRoleGUID}}/attach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "NewRelationshipRequestBody",
  "properties": {
      "class" : "AssignmentScope",
      "assignmentType" : "Add type here",
      "description" : "Add assignment description here"
  },
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false
}


###
# @name detachProductManager
# Detach a product manager from a digital product. Request body is optional.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/digital-products/{{digitalProductGUID}}/product-managers/{{digitalProductManagerRoleGUID}}/detach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "DeleteRelationshipRequestBody",
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false
}

###
# ---------------------------------------------------------------------------------------------------------------------
# digital product dependency is a multi-link relationship.  The attach above returns the new relationship's unique identifier;
# these two requests act on that single relationship.  The detach that takes the two end GUIDs removes them all.

@digitalProductDependencyRelationshipGUID=add guid here
###
# @name updateDigitalProductDependency
# Update the properties of a digital product dependency relationship.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/digital-product-dependencies/{{digitalProductDependencyRelationshipGUID}}/update
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "UpdateRelationshipRequestBody",
  "mergeUpdate": true,
  "properties": {
    "class": "DigitalProductDependencyProperties",
    "label": "add label",
    "description": "add description",
    "effectiveFrom": "{{$isoTimestamp}}",
    "effectiveTo": "{{$isoTimestamp}}"
  },
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false
}

###
# @name detachDigitalProductDependencyById
# Remove a single digital product dependency relationship, identified by its own unique identifier.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/digital-product-dependencies/{{digitalProductDependencyRelationshipGUID}}/detach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "DeleteRelationshipRequestBody",
  "externalSourceGUID": "add guid here",
  "externalSourceName": "add qualified name here",
  "effectiveTime" : "{{$isoTimestamp}}",
  "forLineage" : false,
  "forDuplicateProcessing" : false
}

###
# =====================================================================================================================
# Bitol documents: Open Data Contract Standard (ODCS) data contracts and Open Data Product Standard (ODPS) data
# products.  A document may be published to an integration daemon (asynchronous - the daemon's Bitol listeners
# catalog, store and distribute it), imported directly (synchronous - the agreement or digital product is created
# and its GUID returned), or generated from an existing agreement or digital product.
#
# @integrationDaemonGUID is the GUID of the integration daemon's SoftwareServer asset in the catalog.
# =====================================================================================================================

###
# @name publishDataContractString
# Send a data contract (YAML or JSON) to an integration daemon for its Bitol listeners.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/integration-daemons/{{integrationDaemonGUID}}/data-contracts/publish-document-string
Authorization: Bearer {{token}}
Content-Type: text/plain

apiVersion: v3.1.0
kind: DataContract
id: 6d0f4b2a-9c1e-4a7f-8b3d-2e5f6a7b8c9d
name: Hampton Hospital weekly measurements
version: 1.0.0
status: active

###
# @name publishDataProductString
# Send a data product (YAML or JSON) to an integration daemon for its Bitol listeners.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/integration-daemons/{{integrationDaemonGUID}}/data-products/publish-document-string
Authorization: Bearer {{token}}
Content-Type: text/plain

apiVersion: v1.0.0
kind: DataProduct
id: 4f0b9a5e-2c31-4b6a-9d7e-1a2b3c4d5e6f
name: Teddy Bear Drop Foot Weekly Measurements
version: 1.0.0
status: active

###
# @name importDataContractString
# Catalog a data contract (YAML or JSON) directly as an Agreement classified as a DataSharingAgreement.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/data-contracts/import-document-string
Authorization: Bearer {{token}}
Content-Type: text/plain

apiVersion: v3.1.0
kind: DataContract
id: 6d0f4b2a-9c1e-4a7f-8b3d-2e5f6a7b8c9d
name: Hampton Hospital weekly measurements
version: 1.0.0
status: active
schema:
  - name: weekly_measurements
    physicalType: csv
    properties:
      - name: PatientId
        logicalType: integer
        primaryKey: true
      - name: Date
        logicalType: date
      - name: AngleLeft
        logicalType: integer
      - name: AngleRight
        logicalType: integer

###
# @name importDataContract
# Catalog a data contract bean (JSON) directly as an Agreement classified as a DataSharingAgreement.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/data-contracts/import-document
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "apiVersion" : "v3.1.0",
  "kind" : "DataContract",
  "id" : "6d0f4b2a-9c1e-4a7f-8b3d-2e5f6a7b8c9d",
  "name" : "Hampton Hospital weekly measurements",
  "version" : "1.0.0",
  "status" : "active"
}

###
# @name importDataProductString
# Catalog a data product (YAML or JSON) directly as a DigitalProduct.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/data-products/import-document-string
Authorization: Bearer {{token}}
Content-Type: text/plain

apiVersion: v1.0.0
kind: DataProduct
id: 4f0b9a5e-2c31-4b6a-9d7e-1a2b3c4d5e6f
name: Teddy Bear Drop Foot Weekly Measurements
version: 1.0.0
status: active
domain: clinical-trials
inputPorts:
  - name: hampton-hospital-weekly-measurements
    version: 1.0.0
    contractId: 6d0f4b2a-9c1e-4a7f-8b3d-2e5f6a7b8c9d

###
# @name importDataProduct
# Catalog a data product bean (JSON) directly as a DigitalProduct.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/data-products/import-document
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "apiVersion" : "v1.0.0",
  "kind" : "DataProduct",
  "id" : "4f0b9a5e-2c31-4b6a-9d7e-1a2b3c4d5e6f",
  "name" : "Teddy Bear Drop Foot Weekly Measurements",
  "version" : "1.0.0",
  "status" : "active",
  "domain" : "clinical-trials"
}

