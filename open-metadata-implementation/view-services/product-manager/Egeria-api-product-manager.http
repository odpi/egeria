###
# @name generateDataContract
# Generate the ODCS document for an agreement.
GET {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/agreements/{{agreementGUID}}/data-contract-document
Authorization: Bearer {{token}}

###
# @name generateDataProduct
# Generate the ODPS document for a digital product.
GET {{baseURL}}/servers/{{viewServer}}/api/open-metadata/product-manager/digital-products/{{digitalProductGUID}}/data-product-document
Authorization: Bearer {{token}}
