# Egeria-asset-catalog-omvs

@baseURL=https://localhost:7443
@viewServer=view-server

###
# =====================================================================================================================
# Manage the authentication token.  Run this request to create/refresh the token.

# @name Token (RequestBody)
POST {{baseURL}}/api/token
Content-Type: application/json

{
  "userId" : "garygeeke",
  "password" : "secret"
}

> {% client.global.set("token", response.body); %}

###
# @name=getAssetTypes
# Return the subtypes for asset.
#
# Asset: https://egeria-project.org/concepts/asset/
GET {{baseURL}}/servers/{{viewServer}}/api/open-metadata/asset-catalog/assets/types
Authorization: Bearer {{token}}


###
# =====================================================================================================================
# Asset search requests

@assetGUID=put guid here


###
# @name=getAssetGraph
# Return all the elements that are anchored to an asset plus relationships between these elements and to other elements.
# Note the number of anchored elements returned is controlled by the paging.
#
# Asset: https://egeria-project.org/concepts/asset/
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/asset-catalog/assets/{{assetGUID}}/as-graph
Authorization: Bearer {{token}}
Content-Type: application/json


###
# @name=getAssetLineageGraph
# Return all the elements that are linked to an asset using lineage relationships.  The relationships are
# retrieved both from the asset, and the anchored schema elements.
#
# Lineage: https://egeria-project.org/features/lineage-management/overview/
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/asset-catalog/assets/{{assetGUID}}/as-lineage-graph
Authorization: Bearer {{token}}
Content-Type: application/json


###
# @name=getAssetLineageGraph - all of the parameters
# Return all the elements that are linked to an asset using lineage relationships.  The relationships are
# retrieved both from the asset, and the anchored schema elements.  maxHops limits how many lineage
# relationships are followed away from the asset in each direction (default 8; 0 means no limit).  Elements where
# the walk stopped with more lineage beyond them have hopLimitReached set.
# includeOnlyRelationships replaces the default lineage relationship types; a supertype name, such as
# LineageRelationship or DataLineageRelationship, includes all of its subtypes.  skipRelationships removes types
# (and their subtypes) from the default or requested list, for example ["DataSetContent"].
#
# Lineage: https://egeria-project.org/features/lineage-management/overview/
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/asset-catalog/assets/{{assetGUID}}/as-lineage-graph
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "AssetLineageGraphRequestBody",
  "effectiveTime" : "{{$isoTimestamp}}",
  "asOfTime": "{{$isoTimestamp}}",
  "includeOnlyRelationships" : ["LineageRelationship"],
  "skipRelationships" : ["DataSetContent"],
  "limitToISCQualifiedName": "",
  "highlightISCQualifiedName": "",
  "allAnchors" : true,
  "maxHops" : 8
}


###
# @name=findAssetsInDomain
# Locate string value in elements that are anchored to assets.
#
# Asset: https://egeria-project.org/concepts/asset/
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/asset-catalog/assets/in-domain/by-search-string
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "searchString" : "Add search string here"
}

###
# Core content pack = 09450b83-20ff-4a8b-a8fb-f9b527bbcba6
# Simple Catalog = 83e785b1-5bcc-4714-8f89-f6639ec55ca0

@metadataCollectionId=09450b83-20ff-4a8b-a8fb-f9b527bbcba6

###
# @name=getAssetsByMetadataCollectionId
# Return a list of assets that come from the requested metadata collection.
#
# Asset: https://egeria-project.org/concepts/asset/
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/asset-catalog/assets/by-metadata-collection-id/{{metadataCollectionId}}
Authorization: Bearer {{token}}
Content-Type: application/json


