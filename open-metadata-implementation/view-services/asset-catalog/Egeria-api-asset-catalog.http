# Egeria-asset-catalog-omvs

@baseURL=https://localhost:7443
@viewServer=view-server

###
# =====================================================================================================================
# Manage the authentication token.  Run this request to create/refresh the token.

# @name Token (RequestBody)
POST {{baseURL}}/api/token
Content-Type: application/json

{
  "userId" : "garygeeke",
  "password" : "secret"
}

> {% client.global.set("token", response.body); %}

###
# @name=getAssetTypes
# Return the subtypes for asset.
#
# Asset: https://egeria-project.org/concepts/asset/
GET {{baseURL}}/servers/{{viewServer}}/api/open-metadata/asset-catalog/assets/types
Authorization: Bearer {{token}}


###
# =====================================================================================================================
# Asset search requests

@assetGUID=put guid here


###
# @name=getAssetGraph
# Return all the elements that are anchored to an asset plus relationships between these elements and to other elements.
# Note the number of anchored elements returned is controlled by the paging.
#
# Asset: https://egeria-project.org/concepts/asset/
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/asset-catalog/assets/{{assetGUID}}/as-graph
Authorization: Bearer {{token}}
Content-Type: application/json


###
# @name=getAssetLineageGraph
# Return all the elements that are linked to an asset using lineage relationships.  The relationships are
# retrieved both from the asset, and the anchored schema elements.
#
# Lineage: https://egeria-project.org/features/lineage-management/overview/
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/asset-catalog/assets/{{assetGUID}}/as-lineage-graph
Authorization: Bearer {{token}}
Content-Type: application/json


###
# @name=getAssetLineageGraph - all of the parameters
# Return all the elements that are linked to an asset using lineage relationships.  The relationships are
# retrieved both from the asset, and the anchored schema elements.  maxHops limits how many lineage
# relationships are followed away from the asset in each direction (default 8; 0 means no limit).  Elements where
# the walk stopped with more lineage beyond them have hopLimitReached set.
# includeOnlyRelationships replaces the default lineage relationship types; a supertype name, such as
# LineageRelationship or DataLineageRelationship, includes all of its subtypes.  skipRelationships removes types
# (and their subtypes) from the default or requested list, for example ["DataSetContent"].
#
# Lineage: https://egeria-project.org/features/lineage-management/overview/
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/asset-catalog/assets/{{assetGUID}}/as-lineage-graph
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "class" : "AssetLineageGraphRequestBody",
  "effectiveTime" : "{{$isoTimestamp}}",
  "asOfTime": "{{$isoTimestamp}}",
  "includeOnlyRelationships" : ["LineageRelationship"],
  "skipRelationships" : ["DataSetContent"],
  "limitToISCQualifiedName": "",
  "highlightISCQualifiedName": "",
  "allAnchors" : true,
  "maxHops" : 8
}


###
# @name=findAssetsInDomain
# Locate string value in elements that are anchored to assets.
# The results are organized by asset.
# Paging applies to the matching elements before they are grouped, so a page may hold fewer assets than the
# page size, and an asset can appear on more than one page.
#
# Asset: https://egeria-project.org/concepts/asset/
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/asset-catalog/assets/in-domain/by-search-string
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "searchString" : "Add search string here"
}

###
# Core content pack = 09450b83-20ff-4a8b-a8fb-f9b527bbcba6
# Simple Catalog = 83e785b1-5bcc-4714-8f89-f6639ec55ca0

@metadataCollectionId=09450b83-20ff-4a8b-a8fb-f9b527bbcba6

###
# @name=getAssetsByMetadataCollectionId
# Return a list of assets that come from the requested metadata collection.
#
# Asset: https://egeria-project.org/concepts/asset/
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/asset-catalog/assets/by-metadata-collection-id/{{metadataCollectionId}}
Authorization: Bearer {{token}}
Content-Type: application/json



###
# =====================================================================================================================
# Data Catalog Vocabulary (DCAT): https://www.w3.org/TR/vocab-dcat-3/
# DCAT documents are exchanged in JSON-LD.  They describe catalogs, datasets (with their distributions), dataset series
# and data services.
# @integrationDaemonGUID is the GUID of the integration daemon's SoftwareServer asset in the catalog.
# =====================================================================================================================

@integrationDaemonGUID=add guid here
@assetGUID=add guid here

###
# @name publishDcatDocument
# Send a DCAT document to an integration daemon for its DCAT listeners (such as the DCAT Cataloguer).
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/asset-catalog/integration-daemons/{{integrationDaemonGUID}}/dcat/publish-document
Authorization: Bearer {{token}}
Content-Type: application/ld+json

{
  "@context": {
    "dcat": "http://www.w3.org/ns/dcat#",
    "dct": "http://purl.org/dc/terms/",
    "foaf": "http://xmlns.com/foaf/0.1/"
  },
  "@id": "https://data.example.gov/dataset/air-quality-2025",
  "@type": "dcat:Dataset",
  "dct:title": "Air quality measurements 2025",
  "dct:description": "Hourly readings of nitrogen dioxide, ozone and particulates from the national monitoring network.",
  "dct:publisher": { "@type": "foaf:Organization", "foaf:name": "Environment Agency" },
  "dcat:keyword": [ "air quality", "pollution" ],
  "dct:license": { "@id": "https://creativecommons.org/licenses/by/4.0/" },
  "dcat:distribution": {
    "@type": "dcat:Distribution",
    "dct:title": "Air quality 2025 (CSV)",
    "dcat:downloadURL": { "@id": "https://data.example.gov/files/air-quality-2025.csv" },
    "dct:format": "CSV"
  }
}

###
# @name importDcatDocument
# Catalog a DCAT document directly.  Each dataset becomes a DataSet asset with an asset for each distribution, each data
# service becomes a DeployedAPI and each catalog becomes a CollectionFolder.  The GUIDs of these elements are returned.
POST {{baseURL}}/servers/{{viewServer}}/api/open-metadata/asset-catalog/assets/dcat/import-document
Authorization: Bearer {{token}}
Content-Type: application/ld+json

{
  "@context": {
    "dcat": "http://www.w3.org/ns/dcat#",
    "dct": "http://purl.org/dc/terms/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "vcard": "http://www.w3.org/2006/vcard/ns#"
  },
  "@id": "https://data.example.gov/dataset/air-quality-2025",
  "@type": "dcat:Dataset",
  "dct:title": "Air quality measurements 2025",
  "dct:description": "Hourly readings of nitrogen dioxide, ozone and particulates from the national monitoring network.",
  "dct:identifier": "air-quality-2025",
  "dct:publisher": { "@type": "foaf:Organization", "foaf:name": "Environment Agency" },
  "dcat:contactPoint": { "@type": "vcard:Organization", "vcard:fn": "Open Data Helpdesk", "vcard:hasEmail": { "@id": "mailto:opendata@environment.example.gov" } },
  "dcat:keyword": [ "air quality", "pollution" ],
  "dct:license": { "@id": "https://creativecommons.org/licenses/by/4.0/" },
  "dcat:landingPage": { "@id": "https://data.example.gov/air-quality" },
  "dcat:distribution": [
    {
      "@type": "dcat:Distribution",
      "dct:title": "Air quality 2025 (CSV)",
      "dcat:downloadURL": { "@id": "https://data.example.gov/files/air-quality-2025.csv" },
      "dct:format": "CSV"
    },
    {
      "@type": "dcat:Distribution",
      "dct:title": "Air quality 2025 (API)",
      "dcat:accessURL": { "@id": "https://api.example.gov/air-quality/v1" }
    }
  ]
}

###
# @name getAssetAsDcat
# Return the DCAT description of an asset.  A DeployedAPI is described as a dcat:DataService; any other type of asset is
# described as a dcat:Dataset.  The "document" property of the response is a complete JSON-LD document.
GET {{baseURL}}/servers/{{viewServer}}/api/open-metadata/asset-catalog/assets/{{assetGUID}}/dcat-document
Authorization: Bearer {{token}}
